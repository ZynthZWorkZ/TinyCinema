<Window x:Class="TinyCinema.FetchMoviesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Fetch Movies" Height="480" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">
    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="#3A3A3A">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#007ACC"/>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,8"/>
        </Style>
    </Window.Resources>

    <Border Background="#0F0F0F"
            CornerRadius="16"
            BorderThickness="1"
            BorderBrush="#2A2A2A">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="#1A1A1A"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <fa:FontAwesome Icon="Download" Foreground="White" Width="14" Height="14" Margin="0,0,8,0"/>
                    <TextBlock Text="Fetch Movies from TinyZone" Foreground="White" FontSize="14"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="CloseButton_Click">
                    <fa:FontAwesome Icon="Close" Foreground="White" Width="12" Height="12"/>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="24">
                <TextBlock Text="Download listing pages and build movie_links.txt"
                           Foreground="#B3FFFFFF"
                           Margin="0,0,0,20"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Pages to fetch:" Foreground="White" VerticalAlignment="Center"/>
                    <TextBox x:Name="PageCountTextBox"
                             Grid.Column="1"
                             Text="1"
                             Background="#2A2A2A"
                             Foreground="White"
                             BorderBrush="#3A3A3A"
                             Padding="8,4"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Base domain:" Foreground="White" VerticalAlignment="Center"/>
                    <ComboBox x:Name="DomainComboBox"
                              Grid.Column="1"
                              Style="{StaticResource ModernComboBoxStyle}"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Save mode:" Foreground="White" VerticalAlignment="Center"/>
                    <ComboBox x:Name="SaveModeComboBox"
                              Grid.Column="1"
                              Style="{StaticResource ModernComboBoxStyle}"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Save to:" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OutputPathText"
                             Grid.Column="1"
                             Foreground="#B3FFFFFF"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0"/>
                    <Button Grid.Column="2"
                            Content="Browse"
                            Click="BrowseOutputPath_Click"
                            Style="{StaticResource ModernButtonStyle}"/>
                </Grid>

                <TextBlock Text="Merge adds new movies to the top of an existing file. Overwrite replaces the file with fetched movies only."
                           Foreground="#808080"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <TextBlock Text="About 36 movies per page. Page 1 is /movie/, page 2 is /movie/2/, etc."
                           Foreground="#808080"
                           FontSize="12"
                           Margin="0,0,0,16"/>

                <ProgressBar x:Name="FetchProgressBar"
                             Height="4"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Background="#2A2A2A"
                             BorderThickness="0"
                             Margin="0,0,0,8"/>

                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           Foreground="#B3FFFFFF"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CancelButton"
                            Grid.Column="1"
                            Content="Cancel"
                            Margin="0,0,8,0"
                            Click="CancelButton_Click"
                            Style="{StaticResource ModernButtonStyle}"/>
                    <Button x:Name="StartButton"
                            Grid.Column="2"
                            Content="Start Fetch"
                            Click="StartButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>

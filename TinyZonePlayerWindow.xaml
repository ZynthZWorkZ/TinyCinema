<Window x:Class="TinyCinema.TinyZonePlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="TinyZone Player"
        Height="720"
        Width="1280"
        MinHeight="480"
        MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="#3A3A3A">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UrlIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0F0F0F"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="#2A2A2A">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="#1A1A1A"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <fa:FontAwesome Icon="Globe"
                                    Foreground="White"
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,8,0"/>
                    <TextBlock x:Name="TitleText"
                               Text="Now Playing"
                               Foreground="White"
                               FontSize="14"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="CloseButton_Click">
                    <fa:FontAwesome Icon="Close" Foreground="White" Width="12" Height="12"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Background="#000000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="UrlsPanelColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Background="#070707">
                    <Border x:Name="PlayerWebViewHost" Visibility="Collapsed">
                        <wv2:WebView2 x:Name="PlayerWebView"/>
                    </Border>
                    <Border x:Name="LoadingOverlay"
                            Panel.ZIndex="10"
                            Background="#070707"
                            Visibility="Visible">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Preparing player..."
                                       Foreground="White"
                                       FontSize="16"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LoadingHintText"
                                       Text="Applying cinema view and selecting Server 1..."
                                       Foreground="#B3FFFFFF"
                                       FontSize="12"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       MaxWidth="420"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="EpisodesTabButton"
                            Grid.Row="0"
                            Width="28"
                            Background="#1A1A1A"
                            BorderThickness="1,0,0,0"
                            BorderBrush="#2A2A2A"
                            Click="EpisodesTabButton_Click"
                            ToolTip="Show Episodes panel"
                            Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <fa:FontAwesome x:Name="EpisodesTabIcon"
                                            Icon="List"
                                            Foreground="#B3FFFFFF"
                                            Width="12"
                                            Height="12"
                                            Margin="0,0,0,6"/>
                            <TextBlock Text="EPS"
                                       Foreground="#B3FFFFFF"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="90"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <Button x:Name="UrlsTabButton"
                            Grid.Row="1"
                            Width="28"
                            Background="#1A1A1A"
                            BorderThickness="1,0,0,0"
                            BorderBrush="#2A2A2A"
                            Click="UrlsTabButton_Click"
                            ToolTip="Show URLs panel">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <fa:FontAwesome x:Name="UrlsTabIcon"
                                        Icon="Link"
                                        Foreground="#B3FFFFFF"
                                        Width="12"
                                        Height="12"
                                        Margin="0,0,0,6"/>
                        <TextBlock Text="URLs"
                                   Foreground="#B3FFFFFF"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="90"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                </Button>
                </Grid>

                <Border x:Name="EpisodesPanel"
                        Grid.Column="2"
                        Background="#141414"
                        BorderBrush="#2A2A2A"
                        BorderThickness="1,0,0,0"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#1A1A1A"
                                Padding="12,10"
                                BorderBrush="#2A2A2A"
                                BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Click="HideEpisodesPanel_Click"
                                        ToolTip="Hide Episodes panel"
                                        Style="{StaticResource UrlIconButtonStyle}"
                                        Background="Transparent"
                                        Width="24"
                                        Height="24"
                                        Margin="0,0,8,0">
                                    <fa:FontAwesome Icon="ChevronRight"
                                                    Foreground="#808080"
                                                    Width="10"
                                                    Height="10"
                                                    IsHitTestVisible="False"/>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="Episodes"
                                               Foreground="White"
                                               FontSize="13"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="EpisodeCountText"
                                               Text="0 episodes"
                                               Foreground="#808080"
                                               FontSize="11"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Background="#141414"
                                Padding="12,10"
                                BorderBrush="#2A2A2A"
                                BorderThickness="0,0,0,1">
                            <ComboBox x:Name="SeasonFilterComboBox"
                                      Background="#1A1A1A"
                                      Foreground="White"
                                      BorderBrush="#3A3A3A"
                                      BorderThickness="1"
                                      Padding="8,6"
                                      SelectionChanged="SeasonFilterComboBox_SelectionChanged"/>
                        </Border>

                        <ListBox x:Name="EpisodesListBox"
                                 Grid.Row="2"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="EpisodesListBox_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="#222222"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#1A2744"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#222222"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayLabel}"
                                               Foreground="#D9D9D9"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border x:Name="UrlsPanel"
                        Grid.Column="2"
                        Background="#141414"
                        BorderBrush="#2A2A2A"
                        BorderThickness="1,0,0,0"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#1A1A1A"
                                Padding="12,10"
                                BorderBrush="#2A2A2A"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="0"
                                            Grid.Column="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Click="HideUrlsPanel_Click"
                                            ToolTip="Hide URLs panel"
                                            Style="{StaticResource UrlIconButtonStyle}"
                                            Background="Transparent"
                                            Width="24"
                                            Height="24"
                                            Margin="0,0,8,0">
                                        <fa:FontAwesome Icon="ChevronRight"
                                                        Foreground="#808080"
                                                        Width="10"
                                                        Height="10"
                                                        IsHitTestVisible="False"/>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="Live URLs"
                                                   Foreground="White"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="UrlCountText"
                                                   Text="0 captured"
                                                   Foreground="#808080"
                                                   FontSize="11"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Row="0"
                                        Grid.Column="1"
                                        Content="Clear"
                                        Click="ClearUrlsButton_Click"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Padding="8,4"
                                        Margin="0"/>
                                <ToggleButton x:Name="UrlCaptureToggle"
                                              Grid.Row="1"
                                              Grid.ColumnSpan="2"
                                              Margin="0,10,0,0"
                                              IsChecked="True"
                                              Click="UrlCaptureToggle_Click"
                                              Background="#2A2A2A"
                                              Foreground="#B3FFFFFF"
                                              BorderBrush="#3A3A3A"
                                              BorderThickness="1"
                                              Padding="10,5"
                                              HorizontalAlignment="Stretch"
                                              Cursor="Hand"
                                              ToolTip="Listen for network URLs">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="CaptureBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <fa:FontAwesome Icon="Rss"
                                                                    Foreground="{TemplateBinding Foreground}"
                                                                    Width="11"
                                                                    Height="11"
                                                                    Margin="0,0,6,0"/>
                                                    <TextBlock Text="Capture URLs"
                                                               Foreground="{TemplateBinding Foreground}"
                                                               FontSize="11"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="CaptureBorder" Property="Background" Value="#1A2744"/>
                                                    <Setter TargetName="CaptureBorder" Property="BorderBrush" Value="#3A5A8A"/>
                                                    <Setter Property="Foreground" Value="#8CB4FF"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CaptureBorder" Property="Background" Value="#333333"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsChecked" Value="True"/>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="CaptureBorder" Property="Background" Value="#223355"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ToggleButton x:Name="HlsFilterToggle"
                                              Grid.Row="2"
                                              Grid.ColumnSpan="2"
                                              Margin="0,8,0,0"
                                              Click="HlsFilterToggle_Click"
                                              Background="#2A2A2A"
                                              Foreground="#B3FFFFFF"
                                              BorderBrush="#3A3A3A"
                                              BorderThickness="1"
                                              Padding="10,5"
                                              HorizontalAlignment="Stretch"
                                              Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="FilterBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <fa:FontAwesome Icon="Filter"
                                                                    Foreground="{TemplateBinding Foreground}"
                                                                    Width="11"
                                                                    Height="11"
                                                                    Margin="0,0,6,0"/>
                                                    <TextBlock Text="HLS streams only"
                                                               Foreground="{TemplateBinding Foreground}"
                                                               FontSize="11"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="FilterBorder" Property="Background" Value="#1E3A1E"/>
                                                    <Setter TargetName="FilterBorder" Property="BorderBrush" Value="#3D6B3D"/>
                                                    <Setter Property="Foreground" Value="#7DD87D"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="FilterBorder" Property="Background" Value="#333333"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsChecked" Value="True"/>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="FilterBorder" Property="Background" Value="#254525"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Background="#141414"
                                Padding="12,0,12,10"
                                BorderBrush="#2A2A2A"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBox x:Name="UrlSearchTextBox"
                                         Background="#1A1A1A"
                                         Foreground="White"
                                         BorderBrush="#3A3A3A"
                                         BorderThickness="1"
                                         Padding="28,6,8,6"
                                         FontSize="11"
                                         TextChanged="UrlSearchTextBox_TextChanged"/>
                                <fa:FontAwesome Icon="Search"
                                                Foreground="#666666"
                                                Width="11"
                                                Height="11"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent">
                            <ItemsControl x:Name="UrlsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#222222"
                                                BorderThickness="0,0,0,1"
                                                Padding="10,8"
                                                Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Border Background="#2A2A2A"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                Margin="0,0,6,0"
                                                                Visibility="{Binding IsStream, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="HLS"
                                                                       Foreground="#7DD87D"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Time}"
                                                                   Foreground="#666666"
                                                                   FontSize="10"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Url}"
                                                               Foreground="#D9D9D9"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Top">
                                                    <Button CommandParameter="{Binding Url}"
                                                            Click="OpenHlsInPlayerButton_Click"
                                                            ToolTip="Open in external player"
                                                            Style="{StaticResource UrlIconButtonStyle}"
                                                            Background="#2A4A2A"
                                                            Margin="0,0,4,0"
                                                            Visibility="{Binding IsStream, Converter={StaticResource BoolToVis}}">
                                                        <fa:FontAwesome Icon="Play"
                                                                        Foreground="#7DD87D"
                                                                        Width="11"
                                                                        Height="11"
                                                                        IsHitTestVisible="False"/>
                                                    </Button>
                                                    <Button CommandParameter="{Binding Url}"
                                                            Click="DownloadHlsButton_Click"
                                                            ToolTip="Download or clip with ffmpeg"
                                                            Style="{StaticResource UrlIconButtonStyle}"
                                                            Background="#2A3548"
                                                            Margin="0,0,4,0"
                                                            Visibility="{Binding IsStream, Converter={StaticResource BoolToVis}}">
                                                        <fa:FontAwesome Icon="Download"
                                                                        Foreground="#7EB8FF"
                                                                        Width="11"
                                                                        Height="11"
                                                                        IsHitTestVisible="False"/>
                                                    </Button>
                                                    <Button CommandParameter="{Binding Url}"
                                                            Click="SendToRokuButton_Click"
                                                            ToolTip="Sideload channel to Roku"
                                                            Style="{StaticResource UrlIconButtonStyle}"
                                                            Background="#3A2448"
                                                            Margin="0,0,4,0"
                                                            Visibility="{Binding IsStream, Converter={StaticResource BoolToVis}}">
                                                        <fa:FontAwesome Icon="Tv"
                                                                        Foreground="#D8A8FF"
                                                                        Width="11"
                                                                        Height="11"
                                                                        IsHitTestVisible="False"/>
                                                    </Button>
                                                    <Button CommandParameter="{Binding Url}"
                                                            Click="CopyUrlButton_Click"
                                                            ToolTip="Copy URL"
                                                            Style="{StaticResource UrlIconButtonStyle}"
                                                            Background="#2A2A2A">
                                                        <fa:FontAwesome Icon="Copy"
                                                                        Foreground="White"
                                                                        Width="12"
                                                                        Height="12"
                                                                        IsHitTestVisible="False"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="#1A1A1A"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusText"
                               Foreground="#B3FFFFFF"
                               FontSize="12"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ToggleButton x:Name="CinemaModeToggle"
                                      Click="CinemaModeToggle_Click"
                                      IsChecked="True"
                                      Background="#2A2A2A"
                                      Foreground="#B3FFFFFF"
                                      BorderBrush="#3A3A3A"
                                      BorderThickness="1"
                                      Padding="10,6"
                                      Margin="0,0,8,0"
                                      Cursor="Hand"
                                      ToolTip="Minimal player-only view">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="CinemaBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:FontAwesome Icon="Film"
                                                            Foreground="{TemplateBinding Foreground}"
                                                            Width="11"
                                                            Height="11"
                                                            Margin="0,0,6,0"/>
                                            <TextBlock Text="Cinema"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="CinemaBorder" Property="Background" Value="#1A2744"/>
                                            <Setter TargetName="CinemaBorder" Property="BorderBrush" Value="#3A5A8A"/>
                                            <Setter Property="Foreground" Value="#8CB4FF"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CinemaBorder" Property="Background" Value="#333333"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Button Content="Refresh"
                                Click="RefreshButton_Click"
                                Style="{StaticResource ActionButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

<UserControl x:Class="TinyCinema.CatalogHeroPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:FontAwesome="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
             Height="300"
             ClipToBounds="True">
    <Grid x:Name="HeroRoot">
        <!-- Backdrop -->
        <Image x:Name="BackdropImage"
               Stretch="UniformToFill"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#EE0B0F14" Offset="0"/>
                    <GradientStop Color="#CC0B0F14" Offset="0.45"/>
                    <GradientStop Color="#990B0F14" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Fill="#66000000"/>

        <!-- Empty state -->
        <StackPanel x:Name="EmptyStatePanel"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
            <FontAwesome:FontAwesome Icon="Film"
                                     Foreground="#475569"
                                     Width="48"
                                     Height="48"
                                     HorizontalAlignment="Center"
                                     Margin="0,0,0,12"/>
            <TextBlock x:Name="EmptyStateText"
                       Text="Select a title to see details"
                       Foreground="#94A3B8"
                       FontSize="16"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Content -->
        <Grid x:Name="ContentPanel" Margin="32,24,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText"
                       Grid.Row="0"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="White"
                       TextWrapping="Wrap"
                       MaxWidth="700"
                       HorizontalAlignment="Left"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock x:Name="YearText" Foreground="#94A3B8" FontSize="14" Margin="0,0,16,0"/>
                <TextBlock x:Name="TypeText" Foreground="{DynamicResource AccentBrush}" FontSize="14" Margin="0,0,16,0"/>
                <TextBlock x:Name="GenreText" Foreground="#94A3B8" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="280" Margin="0,0,16,0"/>
                <TextBlock x:Name="DurationText" Foreground="#94A3B8" FontSize="14" Margin="0,0,16,0"/>
                <TextBlock x:Name="CountryText" Foreground="#94A3B8" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,12,0,12">
                <TextBlock x:Name="DescriptionText"
                           Foreground="#CBD5E1"
                           FontSize="14"
                           TextWrapping="Wrap"
                           LineHeight="22"
                           MaxWidth="680"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           MaxHeight="80"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel x:Name="DescriptionLoadingPanel"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                    <FontAwesome:FontAwesome Icon="Spinner"
                                             Foreground="#64748B"
                                             Width="16"
                                             Height="16"
                                             Margin="0,0,8,0"/>
                    <TextBlock Text="Loading description..."
                               Foreground="#64748B"
                               FontSize="13"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal">
                <Button x:Name="PlayButton"
                        Style="{StaticResource HeroPrimaryButtonStyle}"
                        Click="PlayButton_Click"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <FontAwesome:FontAwesome Icon="Play" Width="14" Height="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Play" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ContinueButton"
                        Style="{StaticResource HeroSecondaryButtonStyle}"
                        Click="ContinueButton_Click"
                        Margin="0,0,10,0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <FontAwesome:FontAwesome Icon="Forward" Width="14" Height="14" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ContinueLabel" Text="Continue" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Button x:Name="FavoriteButton"
                        Style="{StaticResource HeroSecondaryButtonStyle}"
                        Click="FavoriteButton_Click"
                        Margin="0,0,10,0"
                        ToolTip="Add to favorites">
                    <StackPanel Orientation="Horizontal">
                        <FontAwesome:FontAwesome x:Name="FavoriteIcon"
                                                 Icon="HeartOutline"
                                                 Foreground="White"
                                                 Width="14"
                                                 Height="14"
                                                 Margin="0,0,8,0"/>
                        <TextBlock x:Name="FavoriteLabel" Text="Favorite"/>
                    </StackPanel>
                </Button>

                <Button x:Name="TrailerButton"
                        Style="{StaticResource HeroSecondaryButtonStyle}"
                        Click="TrailerButton_Click"
                        Margin="0,0,10,0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <FontAwesome:FontAwesome Icon="Film" Width="14" Height="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Trailer"/>
                    </StackPanel>
                </Button>

                <Button x:Name="OpeningCreditsButton"
                        Style="{StaticResource HeroSecondaryButtonStyle}"
                        Click="OpeningCreditsButton_Click"
                        Margin="0,0,10,0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <FontAwesome:FontAwesome Icon="PlayCircle" Width="14" Height="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Opening Credits"/>
                    </StackPanel>
                </Button>

                <Button x:Name="InfoButton"
                        Style="{StaticResource HeroSecondaryButtonStyle}"
                        Click="InfoButton_Click"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <FontAwesome:FontAwesome Icon="InfoCircle" Width="14" Height="14" Margin="0,0,8,0"/>
                        <TextBlock x:Name="InfoButtonLabel" Text="More Info"/>
                    </StackPanel>
                </Button>

                <Button x:Name="UrlButton"
                        Style="{StaticResource HeroSecondaryButtonStyle}"
                        Click="UrlButton_Click"
                        Margin="0,0,10,0"
                        ToolTip="Open source URL">
                    <StackPanel Orientation="Horizontal">
                        <FontAwesome:FontAwesome Icon="Link" Width="14" Height="14" Margin="0,0,8,0"/>
                        <TextBlock Text="URL"/>
                    </StackPanel>
                </Button>

                <Button x:Name="RokuButton"
                        Style="{StaticResource HeroSecondaryButtonStyle}"
                        Click="RokuButton_Click"
                        ToolTip="Play on Roku">
                    <StackPanel Orientation="Horizontal">
                        <FontAwesome:FontAwesome Icon="Tv" Width="14" Height="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Roku"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

<Window x:Class="TinyCinema.ImportNetflixGapsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Netflix Gaps"
        Height="360"
        Width="520"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">
    <Border Background="#0F0F0F"
            CornerRadius="16"
            BorderThickness="1"
            BorderBrush="#2A2A2A">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Import Netflix Gaps"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1"
                       Text="Adds Netflix titles that are not already in Movies.json using VidSrc playback. Requires a TMDB API key."
                       Foreground="#94A3B8"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="0,0,0,16"/>

            <TextBlock x:Name="SummaryText"
                       Grid.Row="2"
                       Foreground="#CBD5E1"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <StackPanel Grid.Row="3" VerticalAlignment="Center">
                <ProgressBar x:Name="ImportProgressBar"
                             Height="8"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Margin="0,0,0,12"/>
                <TextBlock x:Name="StatusText"
                           Text="Ready to import."
                           Foreground="#94A3B8"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Width="100"
                        Margin="0,0,10,0"
                        Padding="12,8"
                        Click="CancelButton_Click"/>
                <Button x:Name="StartButton"
                        Content="Start Import"
                        Width="120"
                        Padding="12,8"
                        Click="StartButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window x:Class="TinyCinema.DownloadOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Download Options" Height="380" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">
    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="#3A3A3A">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#007ACC"/>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0F0F0F"
            CornerRadius="16"
            BorderThickness="1"
            BorderBrush="#2A2A2A">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="#1A1A1A"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <fa:FontAwesome Icon="Download" Foreground="White" Width="14" Height="14" Margin="0,0,8,0"/>
                    <TextBlock Text="Download Options" Foreground="White" FontSize="14"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="CloseButton_Click">
                    <fa:FontAwesome Icon="Close" Foreground="White" Width="12" Height="12"/>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="24">
                <TextBlock Text="Choose what to download from the captured HLS stream."
                           Foreground="#B3FFFFFF"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"/>

                <RadioButton x:Name="FullDownloadRadio"
                             Content="Full download"
                             Foreground="White"
                             Margin="0,0,0,8"/>
                <TextBlock Text="Download the entire stream as an MP4 file."
                           Foreground="#808080"
                           FontSize="11"
                           Margin="24,0,0,16"/>

                <RadioButton x:Name="ClipDownloadRadio"
                             Content="Clip only"
                             Foreground="White"
                             Margin="0,0,0,8"/>
                <TextBlock Text="Download only a time range (use HH:MM:SS, MM:SS, or seconds)."
                           Foreground="#808080"
                           FontSize="11"
                           Margin="24,0,0,12"/>

                <Grid x:Name="ClipTimingPanel"
                      IsEnabled="False"
                      Opacity="0.5"
                      Margin="24,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Start"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBox x:Name="StartTimeTextBox"
                             Grid.Column="1"
                             Text="00:00:00"
                             Background="#2A2A2A"
                             Foreground="White"
                             BorderBrush="#3A3A3A"
                             Padding="8,6"/>
                    <TextBlock Grid.Column="3"
                               Text="End"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBox x:Name="EndTimeTextBox"
                             Grid.Column="4"
                             Text="00:01:00"
                             Background="#2A2A2A"
                             Foreground="White"
                             BorderBrush="#3A3A3A"
                             Padding="8,6"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Click="CancelButton_Click"
                            Style="{StaticResource ModernButtonStyle}"
                            Margin="0,0,8,0"/>
                    <Button Content="Start Download"
                            Click="StartDownloadButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>

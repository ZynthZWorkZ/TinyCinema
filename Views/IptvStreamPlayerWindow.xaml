<Window x:Class="TinyCinema.IptvStreamPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Live TV"
        Height="540"
        Width="960"
        MinHeight="360"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True">
    <Border Background="#0F0F0F"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="#2A2A2A">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="#1A1A1A"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <fa:FontAwesome Icon="Television"
                                    Foreground="White"
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,8,0"/>
                    <TextBlock x:Name="TitleText"
                               Text="Live TV"
                               Foreground="White"
                               FontSize="14"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="620"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="FFPLAY"
                            Click="OpenFfplayButton_Click"
                            Style="{StaticResource ActionButtonStyle}"
                            Padding="10,4"
                            Margin="0,0,4,0"/>
                    <Button Content="VLC"
                            Click="OpenVlcButton_Click"
                            Style="{StaticResource ActionButtonStyle}"
                            Padding="10,4"
                            Margin="0,0,4,0"
                            Visibility="Collapsed"
                            x:Name="VlcButton"/>
                    <Button Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_Click">
                        <fa:FontAwesome Icon="Close" Foreground="White" Width="12" Height="12"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Background="#000000">
                <wv2:WebView2 x:Name="PlayerWebView"/>
                <Border x:Name="LoadingOverlay"
                        Background="#CC000000"
                        Visibility="Visible">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <fa:FontAwesome Icon="Spinner"
                                        Foreground="#8CB4FF"
                                        Width="28"
                                        Height="28"
                                        HorizontalAlignment="Center"/>
                        <TextBlock Text="Starting stream..."
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="#1A1A1A"
                    Padding="12,8">
                <TextBlock x:Name="StatusText"
                           Foreground="#B3FFFFFF"
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Border>
</Window>

<Window x:Class="TinyCinema.TinyZonePlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="TinyZone Player"
        Height="720"
        Width="1280"
        MinHeight="480"
        MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/StreamingTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PlayerActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource NavActiveBackgroundBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource NavHoverBackgroundBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayerActionButtonStyle}"/>

        <Style x:Key="UrlIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconRoot" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconRoot" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayerSideTabButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource NavHoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayerPanelHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TitleBarBackgroundBrush}"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <DataTemplate x:Key="SeasonItemTemplate">
            <TextBlock Text="{Binding StringFormat=Season {0}}"
                       Foreground="#E5E5E5"
                       FontSize="13"/>
        </DataTemplate>

        <Style x:Key="PlayerLoadingProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="3"/>
            <Setter Property="IsIndeterminate" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="PlayerComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#243047"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayerSeasonComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource PlayerComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="10,0,4,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                                    <Path Grid.Column="1"
                                          Width="10"
                                          Height="6"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          Fill="#A3A3A3"
                                          Data="M 0 0 L 5 6 L 10 0 Z"/>
                                </Grid>
                            </ToggleButton>
                            <Popup Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="#141414"
                                        BorderBrush="#3A3A3A"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0"
                                        Padding="0,4">
                                    <ScrollViewer MaxHeight="260"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource AppBackgroundBrush}"
            CornerRadius="14"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="0"
                              Opacity="0.55"
                              Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28"
                                Height="28"
                                CornerRadius="8"
                                Background="{DynamicResource NavActiveBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Margin="0,0,10,0">
                            <fa:FontAwesome Icon="Film"
                                            Foreground="{DynamicResource AccentBrush}"
                                            Width="13"
                                            Height="13"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText"
                                       Text="Now Playing"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="TinyCinema Player"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="10"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="ProbeSnapshotButton"
                            Style="{StaticResource ActionButtonStyle}"
                            Width="32"
                            Height="28"
                            Padding="0"
                            Margin="0,0,4,0"
                            Visibility="Collapsed"
                            Click="ProbeSnapshotButton_Click"
                            ToolTip="Probe snapshot">
                        <fa:FontAwesome Icon="Bug" Width="12" Height="12"/>
                    </Button>
                    <Button x:Name="ProbeOpenFolderButton"
                            Style="{StaticResource ActionButtonStyle}"
                            Width="32"
                            Height="28"
                            Padding="0"
                            Margin="0,0,4,0"
                            Visibility="Collapsed"
                            Click="ProbeOpenFolderButton_Click"
                            ToolTip="Open probe log folder">
                        <fa:FontAwesome Icon="FolderOpen" Width="12" Height="12"/>
                    </Button>
                    <Button Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_Click">
                        <fa:FontAwesome Icon="Close" Foreground="White" Width="12" Height="12"/>
                    </Button>
                </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Background="#050505">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="UrlsPanelColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Background="#050505" Margin="8,8,0,8">
                    <Border CornerRadius="10"
                            Background="#000000"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PlayerWebViewHost" Visibility="Collapsed">
                                <wv2:WebView2 x:Name="PlayerWebView"/>
                            </Border>
                            <Border x:Name="LoadingOverlay"
                                    Panel.ZIndex="10"
                                    Background="#080808"
                                    Visibility="Visible">
                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            MaxWidth="440"
                                            Margin="24">
                                    <fa:FontAwesome Icon="Spinner"
                                                    Foreground="{DynamicResource AccentBrush}"
                                                    Width="28"
                                                    Height="28"
                                                    HorizontalAlignment="Center"
                                                    Spin="True"
                                                    SpinDuration="1.2"/>
                                    <TextBlock Text="Preparing player"
                                               Foreground="White"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,16,0,0"/>
                                    <TextBlock x:Name="LoadingHintText"
                                               Text="Applying cinema view and selecting Server 1..."
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="12"
                                               Margin="0,8,0,16"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                    <ProgressBar Style="{StaticResource PlayerLoadingProgressStyle}"
                                                 Width="220"
                                                 HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="EpisodesTabButton"
                            Grid.Row="0"
                            Style="{StaticResource PlayerSideTabButtonStyle}"
                            Click="EpisodesTabButton_Click"
                            ToolTip="Show Episodes panel"
                            Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <fa:FontAwesome x:Name="EpisodesTabIcon"
                                            Icon="List"
                                            Foreground="#B3FFFFFF"
                                            Width="12"
                                            Height="12"
                                            Margin="0,0,0,6"/>
                            <TextBlock Text="EPS"
                                       Foreground="#B3FFFFFF"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="90"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <Button x:Name="UrlsTabButton"
                            Grid.Row="1"
                            Style="{StaticResource PlayerSideTabButtonStyle}"
                            Click="UrlsTabButton_Click"
                            ToolTip="Show URLs panel">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <fa:FontAwesome x:Name="UrlsTabIcon"
                                        Icon="Link"
                                        Foreground="#B3FFFFFF"
                                        Width="12"
                                        Height="12"
                                        Margin="0,0,0,6"/>
                        <TextBlock Text="URLs"
                                   Foreground="#B3FFFFFF"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="90"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                </Button>
                </Grid>

                <Border x:Name="EpisodesPanel"
                        Grid.Column="2"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,0,0,0"
                        Margin="0,8,8,8"
                        CornerRadius="10"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Style="{StaticResource PlayerPanelHeaderStyle}"
                                CornerRadius="10,10,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Click="HideEpisodesPanel_Click"
                                        ToolTip="Hide Episodes panel"
                                        Style="{StaticResource UrlIconButtonStyle}"
                                        Background="Transparent"
                                        Width="24"
                                        Height="24"
                                        Margin="0,0,8,0">
                                    <fa:FontAwesome Icon="ChevronRight"
                                                    Foreground="#808080"
                                                    Width="10"
                                                    Height="10"
                                                    IsHitTestVisible="False"/>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="Episodes"
                                               Foreground="White"
                                               FontSize="13"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="EpisodeCountText"
                                               Text="0 episodes"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                Padding="12,10"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <ComboBox x:Name="SeasonFilterComboBox"
                                      Style="{StaticResource PlayerSeasonComboBoxStyle}"
                                      ItemTemplate="{StaticResource SeasonItemTemplate}"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="SeasonFilterComboBox_SelectionChanged"/>
                        </Border>

                        <ListBox x:Name="EpisodesListBox"
                                 Grid.Row="2"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0,6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="EpisodesListBox_SelectionChanged">
                            <ListBox.Resources>
                                <Style TargetType="ScrollViewer" BasedOn="{StaticResource ModernScrollViewerStyle}"/>
                            </ListBox.Resources>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="EpisodeRow"
                                                        Background="Transparent"
                                                        CornerRadius="10"
                                                        Padding="{TemplateBinding Padding}"
                                                        BorderThickness="1"
                                                        BorderBrush="Transparent">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="EpisodeRow" Property="Background" Value="#1A2438"/>
                                                        <Setter TargetName="EpisodeRow" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="EpisodeRow" Property="Background" Value="#161616"/>
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsSelected" Value="True"/>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="EpisodeRow" Property="Background" Value="#1E2D45"/>
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="104"
                                                Height="58"
                                                CornerRadius="8"
                                                Background="#101010"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                Margin="0,0,12,0"
                                                ClipToBounds="True">
                                            <Grid>
                                                <fa:FontAwesome Icon="Film"
                                                                Foreground="#333333"
                                                                Width="16"
                                                                Height="16"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                                <Image Source="{Binding CachedThumbnail}"
                                                       Stretch="UniformToFill"
                                                       Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <TextBlock Text="{Binding EpisodeNumberLabel}"
                                                           Foreground="#F5F5F5"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"/>
                                                <Border Background="#243047"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        Margin="8,0,0,0"
                                                        Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="NOW"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="9"
                                                               FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border x:Name="UrlsPanel"
                        Grid.Column="2"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,0,0,0"
                        Margin="0,8,8,8"
                        CornerRadius="10"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Style="{StaticResource PlayerPanelHeaderStyle}"
                                CornerRadius="10,10,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="0"
                                            Grid.Column="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Click="HideUrlsPanel_Click"
                                            ToolTip="Hide URLs panel"
                                            Style="{StaticResource UrlIconButtonStyle}"
                                            Background="Transparent"
                                            Width="24"
                                            Height="24"
                                            Margin="0,0,8,0">
                                        <fa:FontAwesome Icon="ChevronRight"
                                                        Foreground="#808080"
                                                        Width="10"
                                                        Height="10"
                                                        IsHitTestVisible="False"/>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="Live URLs"
                                                   Foreground="White"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="UrlCountText"
                                                   Text="0 captured"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Row="0"
                                        Grid.Column="1"
                                        Content="Clear"
                                        Click="ClearUrlsButton_Click"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Padding="8,4"
                                        Margin="0"/>
                                <ToggleButton x:Name="UrlCaptureToggle"
                                              Grid.Row="1"
                                              Grid.ColumnSpan="2"
                                              Margin="0,10,0,0"
                                              IsChecked="True"
                                              Click="UrlCaptureToggle_Click"
                                              Background="#2A2A2A"
                                              Foreground="#B3FFFFFF"
                                              BorderBrush="#3A3A3A"
                                              BorderThickness="1"
                                              Padding="10,5"
                                              HorizontalAlignment="Stretch"
                                              Cursor="Hand"
                                              ToolTip="Listen for network URLs">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="CaptureBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <fa:FontAwesome Icon="Rss"
                                                                    Foreground="{TemplateBinding Foreground}"
                                                                    Width="11"
                                                                    Height="11"
                                                                    Margin="0,0,6,0"/>
                                                    <TextBlock Text="Capture URLs"
                                                               Foreground="{TemplateBinding Foreground}"
                                                               FontSize="11"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="CaptureBorder" Property="Background" Value="#1A2744"/>
                                                    <Setter TargetName="CaptureBorder" Property="BorderBrush" Value="#3A5A8A"/>
                                                    <Setter Property="Foreground" Value="#8CB4FF"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CaptureBorder" Property="Background" Value="#333333"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsChecked" Value="True"/>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="CaptureBorder" Property="Background" Value="#223355"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ToggleButton x:Name="HlsFilterToggle"
                                              Grid.Row="2"
                                              Grid.ColumnSpan="2"
                                              Margin="0,8,0,0"
                                              Click="HlsFilterToggle_Click"
                                              Background="#2A2A2A"
                                              Foreground="#B3FFFFFF"
                                              BorderBrush="#3A3A3A"
                                              BorderThickness="1"
                                              Padding="10,5"
                                              HorizontalAlignment="Stretch"
                                              Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="FilterBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <fa:FontAwesome Icon="Filter"
                                                                    Foreground="{TemplateBinding Foreground}"
                                                                    Width="11"
                                                                    Height="11"
                                                                    Margin="0,0,6,0"/>
                                                    <TextBlock Text="HLS streams only"
                                                               Foreground="{TemplateBinding Foreground}"
                                                               FontSize="11"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="FilterBorder" Property="Background" Value="#1E3A1E"/>
                                                    <Setter TargetName="FilterBorder" Property="BorderBrush" Value="#3D6B3D"/>
                                                    <Setter Property="Foreground" Value="#7DD87D"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="FilterBorder" Property="Background" Value="#333333"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsChecked" Value="True"/>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="FilterBorder" Property="Background" Value="#254525"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                Padding="12,0,12,10"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Border Background="{DynamicResource NavActiveBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="1">
                                <Grid>
                                    <TextBox x:Name="UrlSearchTextBox"
                                             Background="Transparent"
                                             Foreground="White"
                                             BorderThickness="0"
                                             Padding="28,8,8,8"
                                             FontSize="11"
                                             TextChanged="UrlSearchTextBox_TextChanged"/>
                                    <fa:FontAwesome Icon="Search"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    Width="11"
                                                    Height="11"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left"
                                                    IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                        </Border>

                        <ScrollViewer Grid.Row="2"
                                      Style="{StaticResource ModernScrollViewerStyle}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent"
                                      Padding="0,4">
                            <ItemsControl x:Name="UrlsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#222222"
                                                BorderThickness="0,0,0,1"
                                                Padding="10,8"
                                                Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Border Background="#2A2A2A"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                Margin="0,0,6,0"
                                                                Visibility="{Binding IsStream, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="HLS"
                                                                       Foreground="#7DD87D"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Time}"
                                                                   Foreground="#666666"
                                                                   FontSize="10"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Url}"
                                                               Foreground="#D9D9D9"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Top">
                                                    <Button CommandParameter="{Binding Url}"
                                                            Click="OpenHlsInPlayerButton_Click"
                                                            ToolTip="Open in external player"
                                                            Style="{StaticResource UrlIconButtonStyle}"
                                                            Background="#2A4A2A"
                                                            Margin="0,0,4,0"
                                                            Visibility="{Binding IsStream, Converter={StaticResource BoolToVis}}">
                                                        <fa:FontAwesome Icon="Play"
                                                                        Foreground="#7DD87D"
                                                                        Width="11"
                                                                        Height="11"
                                                                        IsHitTestVisible="False"/>
                                                    </Button>
                                                    <Button CommandParameter="{Binding Url}"
                                                            Click="DownloadHlsButton_Click"
                                                            ToolTip="Download or clip with ffmpeg"
                                                            Style="{StaticResource UrlIconButtonStyle}"
                                                            Background="#2A3548"
                                                            Margin="0,0,4,0"
                                                            Visibility="{Binding IsStream, Converter={StaticResource BoolToVis}}">
                                                        <fa:FontAwesome Icon="Download"
                                                                        Foreground="#7EB8FF"
                                                                        Width="11"
                                                                        Height="11"
                                                                        IsHitTestVisible="False"/>
                                                    </Button>
                                                    <Button CommandParameter="{Binding Url}"
                                                            Click="SendToRokuButton_Click"
                                                            ToolTip="Sideload channel to Roku"
                                                            Style="{StaticResource UrlIconButtonStyle}"
                                                            Background="#3A2448"
                                                            Margin="0,0,4,0"
                                                            Visibility="{Binding IsStream, Converter={StaticResource BoolToVis}}">
                                                        <fa:FontAwesome Icon="Tv"
                                                                        Foreground="#D8A8FF"
                                                                        Width="11"
                                                                        Height="11"
                                                                        IsHitTestVisible="False"/>
                                                    </Button>
                                                    <Button CommandParameter="{Binding Url}"
                                                            Click="CopyUrlButton_Click"
                                                            ToolTip="Copy URL"
                                                            Style="{StaticResource UrlIconButtonStyle}"
                                                            Background="#2A2A2A">
                                                        <fa:FontAwesome Icon="Copy"
                                                                        Foreground="White"
                                                                        Width="12"
                                                                        Height="12"
                                                                        IsHitTestVisible="False"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14"
                    Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Status"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,2"/>
                        <TextBlock x:Name="StatusText"
                                   Foreground="#D9D9D9"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ComboBox x:Name="TvSourceComboBox"
                                  Style="{StaticResource PlayerSeasonComboBoxStyle}"
                                  Width="132"
                                  Margin="0,0,8,0"
                                  Visibility="Collapsed"
                                  ToolTip="TV playback provider"
                                  SelectionChanged="TvSourceComboBox_SelectionChanged">
                            <ComboBoxItem Content="MovieLair"/>
                            <ComboBoxItem Content="VidSrc"/>
                        </ComboBox>
                        <ComboBox x:Name="TvServerComboBox"
                                  Style="{StaticResource PlayerSeasonComboBoxStyle}"
                                  Width="120"
                                  Margin="0,0,8,0"
                                  Visibility="Collapsed"
                                  ToolTip="MovieLair playback server"
                                  SelectionChanged="TvServerComboBox_SelectionChanged"/>
                        <ComboBox x:Name="MovieSourceComboBox"
                                  Style="{StaticResource PlayerSeasonComboBoxStyle}"
                                  Width="132"
                                  Margin="0,0,8,0"
                                  Visibility="Collapsed"
                                  SelectionChanged="MovieSourceComboBox_SelectionChanged">
                            <ComboBoxItem Content="TinyZone"/>
                            <ComboBoxItem Content="MovieLair"/>
                            <ComboBoxItem Content="VidSrc"/>
                        </ComboBox>
                        <ToggleButton x:Name="CinemaModeToggle"
                                      Click="CinemaModeToggle_Click"
                                      IsChecked="True"
                                      Background="#2A2A2A"
                                      Foreground="#B3FFFFFF"
                                      BorderBrush="#3A3A3A"
                                      BorderThickness="1"
                                      Padding="10,6"
                                      Margin="0,0,8,0"
                                      Cursor="Hand"
                                      ToolTip="Minimal player-only view">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="CinemaBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:FontAwesome Icon="Film"
                                                            Foreground="{TemplateBinding Foreground}"
                                                            Width="11"
                                                            Height="11"
                                                            Margin="0,0,6,0"/>
                                            <TextBlock Text="Cinema"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="CinemaBorder" Property="Background" Value="#1A2744"/>
                                            <Setter TargetName="CinemaBorder" Property="BorderBrush" Value="#3A5A8A"/>
                                            <Setter Property="Foreground" Value="#8CB4FF"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CinemaBorder" Property="Background" Value="#333333"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Button Content="Refresh"
                                Click="RefreshButton_Click"
                                Style="{StaticResource ActionButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

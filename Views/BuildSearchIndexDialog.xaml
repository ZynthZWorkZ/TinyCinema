<Window x:Class="TinyCinema.BuildSearchIndexDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Build Smart Search Index" Height="620" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        MinHeight="480"
        MinWidth="560"
        WindowStyle="None"
        AllowsTransparency="True">
    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="#3A3A3A">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#007ACC"/>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0F0F0F"
            CornerRadius="16"
            BorderThickness="1"
            BorderBrush="#2A2A2A">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="#1A1A1A"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <fa:FontAwesome Icon="Search" Foreground="White" Width="14" Height="14" Margin="0,0,8,0"/>
                    <TextBlock Text="Build Smart Search Index" Foreground="White" FontSize="14"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="CloseButton_Click">
                    <fa:FontAwesome Icon="Close" Foreground="White" Width="12" Height="12"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Semantic search index"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1"
                           Text="Build runs on a background thread. The log below shows every step — model load, JSON read, each movie embedded, and save progress."
                           Foreground="#B3FFFFFF"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <TextBlock Text="Catalog file"
                               Foreground="#99FFFFFF"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="CatalogPathText"
                               Foreground="White"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <TextBlock Grid.Row="3"
                           x:Name="PhaseText"
                           Text=""
                           Foreground="#7EC8FF"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <StackPanel Grid.Row="4" Margin="0,0,0,10">
                    <ProgressBar x:Name="BuildProgressBar"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Margin="0,0,0,6"/>
                    <TextBlock x:Name="StatusText"
                               Text="Ready to build."
                               Foreground="#B3FFFFFF"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="StatsText"
                               Text=""
                               Foreground="#88FFFFFF"
                               FontSize="12"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Row="5"
                        Background="#141414"
                        BorderBrush="#2A2A2A"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="Build log"
                                   Foreground="#99FFFFFF"
                                   Margin="10,8,10,4"/>
                        <ScrollViewer Grid.Row="1"
                                      x:Name="LogScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      Margin="4,0,4,4">
                            <TextBlock x:Name="LogTextBlock"
                                       TextWrapping="Wrap"
                                       Foreground="#DDDDDD"
                                       FontFamily="Consolas"
                                       FontSize="11"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LogFilePathText"
                               Text=""
                               Foreground="#66FFFFFF"
                               FontSize="11"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="OpenLogButton"
                                Content="Open Log File"
                                Style="{StaticResource ModernButtonStyle}"
                                Margin="0,0,8,0"
                                Click="OpenLogButton_Click"
                                IsEnabled="False"/>
                        <Button x:Name="CancelButton"
                                Content="Close"
                                Style="{StaticResource ModernButtonStyle}"
                                Margin="0,0,8,0"
                                Click="CancelButton_Click"/>
                        <Button x:Name="StartButton"
                                Content="Build Index"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="StartButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

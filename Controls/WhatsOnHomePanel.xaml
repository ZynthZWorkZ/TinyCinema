<UserControl x:Class="TinyCinema.WhatsOnHomePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:FontAwesome="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
             xmlns:local="clr-namespace:TinyCinema"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="WhatsOnServiceButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="132"/>
            <Setter Property="Height" Value="156"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardRoot"
                                CornerRadius="16"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Padding="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="CardRoot" Property="Background" Value="#151B28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WhatsOnMovieCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="ServicesView">
            <StackPanel Margin="0,0,4,12">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <FontAwesome:FontAwesome Icon="Fire"
                                             Foreground="{DynamicResource AccentBrush}"
                                             Width="18"
                                             Height="18"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="What's On"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="Browse live streaming catalogs and play titles from your library or VidSrc."
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24"/>

                <ItemsControl x:Name="ServicesItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:WhatsOnStreamingService}">
                            <Button Style="{StaticResource WhatsOnServiceButtonStyle}"
                                    Click="NetflixServiceButton_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="72"
                                            Height="72"
                                            CornerRadius="10"
                                            Background="#E50914"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="N"
                                                   Foreground="White"
                                                   FontSize="44"
                                                   FontWeight="Bold"
                                                   FontFamily="Segoe UI, Arial"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,-2,0,0"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="White"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,12,0,0"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <Grid x:Name="MoviesView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Back"
                        Padding="14,8"
                        Margin="0,0,12,0"
                        Background="#2A2A2A"
                        Foreground="White"
                        BorderBrush="#444"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="BackToServicesButton_Click"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="NetflixHeaderText"
                               Text="Netflix Movies"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="NetflixSubheaderText"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Refresh"
                        Padding="14,8"
                        Background="#2A2A2A"
                        Foreground="White"
                        BorderBrush="#444"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="RefreshNetflixButton_Click"/>
            </Grid>

            <ScrollViewer x:Name="MoviesScrollViewer"
                          Grid.Row="1"
                          Style="{StaticResource ModernScrollViewerStyle}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl x:Name="MoviesItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:WhatsOnMovieEntry}">
                                <Button Style="{StaticResource WhatsOnMovieCardButtonStyle}"
                                        Tag="{Binding}"
                                        Margin="0,0,14,14"
                                        Click="MovieCard_Click">
                                    <Border Width="150"
                                            Height="225"
                                            CornerRadius="10"
                                            Background="{DynamicResource PanelBackgroundBrush}"
                                            BorderThickness="2"
                                            ClipToBounds="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#334155"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="BorderBrush" Value="#475569"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Border Background="{DynamicResource PanelBackgroundBrush}"
                                                    Visibility="{Binding IsLoadingPoster, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                                <fa:FontAwesome Icon="Spinner"
                                                                Foreground="{DynamicResource InputMutedForegroundBrush}"
                                                                Width="28"
                                                                Height="28"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>

                                            <Image Source="{Binding PosterImage}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                                            <Border VerticalAlignment="Top"
                                                    HorizontalAlignment="Left"
                                                    Margin="8"
                                                    Background="#CC0B0F14"
                                                    BorderBrush="#334155"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="6,4"
                                                    Visibility="{Binding IsInCatalog, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="In Catalog"
                                                           Foreground="#10B981"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"/>
                                            </Border>

                                            <Border VerticalAlignment="Bottom">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#00000000" Offset="0"/>
                                                        <GradientStop Color="#DD0B0F14" Offset="0.35"/>
                                                        <GradientStop Color="#F00B0F14" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel Margin="10,24,10,10">
                                                    <TextBlock Text="{Binding Item.Title}"
                                                               Foreground="White"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="40"/>
                                                    <TextBlock Text="{Binding Item.Year}"
                                                               Foreground="#B3FFFFFF"
                                                               FontSize="11"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button x:Name="LoadMoreButton"
                            Content="Load more"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,16"
                            Padding="24,10"
                            Visibility="Collapsed"
                            Background="#2A2A2A"
                            Foreground="White"
                            BorderBrush="#555"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="LoadMoreButton_Click"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="EmptyStatePanel"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <fa:FontAwesome Icon="Search"
                                Foreground="#475569"
                                Width="42"
                                Height="42"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,14"/>
                <TextBlock Text="No Netflix titles match your search."
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="15"
                           TextAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Border x:Name="LoadingOverlay"
                Background="#CC0B0F14"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="420">
                <fa:FontAwesome Icon="Spinner"
                                Foreground="{DynamicResource AccentBrush}"
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Center"/>
                <TextBlock x:Name="LoadingStatusText"
                           Text="Fetching Netflix listings..."
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="15"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="TinyCinema.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d"
             Background="Transparent">

    <ScrollViewer Style="{StaticResource ModernScrollViewerStyle}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760"
                    HorizontalAlignment="Center"
                    Margin="24,8,24,32">
            <StackPanel Margin="0,0,0,28">
                <TextBlock Text="Settings"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="White"/>
                <TextBlock Text="Customize appearance, catalogs, playback, and integrations."
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="14"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel>
                    <!-- Appearance -->
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal"
                                        Margin="0,0,0,12">
                                <fa:FontAwesome Icon="PaintBrush"
                                                Foreground="{DynamicResource AccentBrush}"
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,8,0"/>
                                <TextBlock Text="Appearance"
                                           Foreground="White"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Theme:"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>

                                <ComboBox x:Name="ThemeComboBox"
                                          Grid.Column="1"
                                          ItemsSource="{Binding AvailableThemes}"
                                          SelectedItem="{Binding SelectedAppTheme}"
                                          SelectionChanged="ThemeComboBox_SelectionChanged"
                                          Style="{StaticResource ModernComboBoxStyle}"/>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Window size:"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>

                                <ComboBox x:Name="WindowSizeComboBox"
                                          Grid.Column="1"
                                          ItemsSource="{Binding AvailableWindowSizes}"
                                          SelectedItem="{Binding SelectedWindowSize}"
                                          SelectionChanged="WindowSizeComboBox_SelectionChanged"
                                          Style="{StaticResource ModernComboBoxStyle}"/>
                            </Grid>

                            <TextBlock Grid.Row="3"
                                       Text="{Binding WindowSizeDescription}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                            <Grid Grid.Row="4" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Start centered on screen"
                                               Foreground="White"/>
                                    <TextBlock Text="When enabled, TinyCinema opens in the middle of your display."
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <ToggleButton Grid.Column="1"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsStartCentered}"
                                              Style="{StaticResource SettingsToggleStyle}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Cache Location Setting -->
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Setting Title -->
                            <StackPanel Orientation="Horizontal" 
                                      Margin="0,0,0,12">
                                <fa:FontAwesome Icon="Folder" 
                                               Foreground="{DynamicResource AccentBrush}"
                                               Width="16"
                                               Height="16"
                                               Margin="0,0,8,0"/>
                                <TextBlock Text="Image Cache Settings" 
                                         Foreground="White"
                                         FontSize="16"
                                         FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <!-- Enable Caching Toggle -->
                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="Enable Image Caching"
                                         Foreground="White"
                                         VerticalAlignment="Center"/>
                                
                                <ToggleButton Grid.Column="1"
                                             IsChecked="{Binding IsCachingEnabled}"
                                             Style="{StaticResource SettingsToggleStyle}"/>
                            </Grid>
                            
                            <!-- Cache Path and Button -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="{Binding CacheLocation}"
                                         Foreground="{DynamicResource TextMutedBrush}"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Center"
                                         Margin="0,0,16,0"/>
                                
                                <Button Grid.Column="1"
                                        Content="Change Location"
                                        Click="SelectCacheLocation_Click"
                                        Style="{StaticResource SettingsOutlineButtonStyle}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- TV Show Episode Cache Setting -->
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal"
                                      Margin="0,0,0,12">
                                <fa:FontAwesome Icon="Television"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Width="16"
                                               Height="16"
                                               Margin="0,0,8,0"/>
                                <TextBlock Text="TV Show Cache Settings"
                                         Foreground="White"
                                         FontSize="16"
                                         FontWeight="SemiBold"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Enable TV Show Episode Caching"
                                         Foreground="White"
                                         VerticalAlignment="Center"
                                         TextWrapping="Wrap"/>

                                <ToggleButton Grid.Column="1"
                                             IsChecked="{Binding IsTvShowCachingEnabled}"
                                             Style="{StaticResource SettingsToggleStyle}"/>
                            </Grid>

                            <TextBlock Grid.Row="2"
                                     Text="{Binding TvShowEpisodeCacheLocation}"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Movie Links File Location Setting -->
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Setting Title -->
                            <StackPanel Orientation="Horizontal" 
                                      Margin="0,0,0,12">
                                <fa:FontAwesome Icon="File" 
                                               Foreground="{DynamicResource AccentBrush}"
                                               Width="16"
                                               Height="16"
                                               Margin="0,0,8,0"/>
                                <TextBlock Text="Movie Catalog Settings" 
                                         Foreground="White"
                                         FontSize="16"
                                         FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <!-- Movie Links File Path and Button -->
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="{Binding MovieCatalogLocation}"
                                         Foreground="{DynamicResource TextMutedBrush}"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Center"
                                         Margin="0,0,16,12"/>
                                
                                <Button Grid.Column="1"
                                        Content="Change Location"
                                        Click="SelectMovieCatalogLocation_Click"
                                        Style="{StaticResource SettingsOutlineButtonStyle}"
                                        Margin="0,0,0,12"/>

                                <Button Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Content="Fetch Movies from TinyZone"
                                        Click="FetchMovies_Click"
                                        Style="{StaticResource HeroPrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,8"/>

                                <Button Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        Content="Add Movie by URL"
                                        Click="AddMovieByUrl_Click"
                                        Style="{StaticResource HeroPrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,8"/>

                                <Button Grid.Row="3"
                                        Grid.ColumnSpan="2"
                                        Content="Build Smart Search Index"
                                        Click="BuildSearchIndex_Click"
                                        Style="{StaticResource HeroPrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="4"
                                           Grid.ColumnSpan="2"
                                           x:Name="SmartSearchStatusText"
                                           Text="Smart search uses your local e5-small-v2 model to search plots, cast, and director."
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- TV Show Links File Location Setting -->
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal"
                                      Margin="0,0,0,12">
                                <fa:FontAwesome Icon="Television"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Width="16"
                                               Height="16"
                                               Margin="0,0,8,0"/>
                                <TextBlock Text="TV Show Catalog Settings"
                                         Foreground="White"
                                         FontSize="16"
                                         FontWeight="SemiBold"/>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding TvShowLinksLocation}"
                                         Foreground="{DynamicResource TextMutedBrush}"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Center"
                                         Margin="0,0,16,12"/>

                                <Button Grid.Column="1"
                                        Content="Change Location"
                                        Click="SelectTvShowLinksLocation_Click"
                                        Style="{StaticResource SettingsOutlineButtonStyle}"
                                        Margin="0,0,0,12"/>

                                <Button Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Content="Fetch TV Shows from MovieLair"
                                        Click="FetchTvShows_Click"
                                        Style="{StaticResource HeroPrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,8"/>

                                <Button Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        Content="Add TV Show by URL"
                                        Click="AddTvShowByUrl_Click"
                                        Style="{StaticResource HeroPrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Player Settings -->
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Setting Title -->
                            <StackPanel Grid.Row="0"
                                      Orientation="Horizontal" 
                                      Margin="0,0,0,12">
                                <fa:FontAwesome Icon="Play" 
                                               Foreground="{DynamicResource AccentBrush}"
                                               Width="16"
                                               Height="16"
                                               Margin="0,0,8,0"/>
                                <TextBlock Text="Player Settings" 
                                         Foreground="White"
                                         FontSize="16"
                                         FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <!-- Player Selection -->
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="Default Player:"
                                         Foreground="White"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"/>
                                
                                <ComboBox x:Name="PlayerComboBox"
                                         Grid.Column="1"
                                         ItemsSource="{Binding AvailablePlayers}"
                                         SelectedItem="{Binding SelectedPlayer}"
                                         SelectionChanged="PlayerComboBox_SelectionChanged"
                                         Style="{StaticResource ModernComboBoxStyle}"/>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Block Popups and Ads"
                                         Foreground="White"
                                         VerticalAlignment="Center"/>

                                <ToggleButton Grid.Column="1"
                                             IsChecked="{Binding IsPopupBlockerEnabled}"
                                             Style="{StaticResource SettingsToggleStyle}"/>
                            </Grid>

                            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                                <TextBlock Text="Blocked Ad / Tracker Hosts"
                                           Foreground="White"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="Used when Block Popups and Ads is on. One host per line. Built-in blocks include llvpn.com and usrpubtrk.com; common ad script paths are blocked on other sites."
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11"
                                           Margin="0,0,0,8"
                                           TextWrapping="Wrap"/>
                                <TextBox Text="{Binding PlayerRequestBlocklist, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="56"
                                         VerticalScrollBarVisibility="Auto"
                                         Style="{StaticResource SettingsInputStyle}"/>
                            </StackPanel>

                            <Grid Grid.Row="4" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Clear Player Browser Data on Close"
                                               Foreground="White"/>
                                    <TextBlock Text="Deletes the in-app browser cache and site data when you close the player. Saves disk space, but sites may load slower next time and saved playback preferences may be lost."
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <ToggleButton Grid.Column="1"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsClearPlayerBrowserDataOnClose}"
                                              Style="{StaticResource SettingsToggleStyle}"/>
                            </Grid>

                            <Grid Grid.Row="5" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="MovieLair Probe Logging"
                                               Foreground="White"/>
                                    <TextBlock Text="Logs iframe JS, storage, and video state to %TEMP%\\TinyCinema\\ProbeLogs"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <ToggleButton Grid.Column="1"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsMovieLairProbeEnabled}"
                                              Style="{StaticResource SettingsToggleStyle}"/>
                            </Grid>

                            <StackPanel Grid.Row="6" Margin="0,0,0,12">
                                <TextBlock Text="Embed Player Hosts"
                                           Foreground="White"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="One host per line (e.g. vsembed.ru). Built-in hosts are always included. Paste a full URL and the domain will be used."
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11"
                                           Margin="0,0,0,8"
                                           TextWrapping="Wrap"/>
                                <TextBox Text="{Binding PlayerEmbedHosts, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="72"
                                         VerticalScrollBarVisibility="Auto"
                                         Style="{StaticResource SettingsInputStyle}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="7"
                                       Text="In-App Browser watches on TinyZone. Other players open automatically when an m3u8 stream is captured."
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- TMDB Settings -->
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal"
                                      Margin="0,0,0,12">
                                <fa:FontAwesome Icon="Film"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Width="16"
                                               Height="16"
                                               Margin="0,0,8,0"/>
                                <TextBlock Text="TMDB Trailer Settings"
                                         Foreground="White"
                                         FontSize="16"
                                         FontWeight="SemiBold"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="API Key:"
                                         Foreground="White"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"
                                         Width="130"/>

                                <TextBox Grid.Column="1"
                                         Text="{Binding TmdbApiKey, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsInputStyle}"/>
                            </Grid>

                            <TextBlock Grid.Row="2"
                                       Text="Used for trailer playback only. Get a free API key at themoviedb.org/settings/api."
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Roku Settings -->
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Setting Title -->
                            <StackPanel Orientation="Horizontal" 
                                      Margin="0,0,0,12">
                                <fa:FontAwesome Icon="Tv" 
                                               Foreground="{DynamicResource AccentBrush}"
                                               Width="16"
                                               Height="16"
                                               Margin="0,0,8,0"/>
                                <TextBlock Text="Roku Sideload Settings" 
                                         Foreground="White"
                                         FontSize="16"
                                         FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <!-- Roku IP Input -->
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="Roku IP Address:"
                                         Foreground="White"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"
                                         Width="130"/>
                                
                                <TextBox Grid.Column="1"
                                         Text="{Binding RokuIpAddress}"
                                         Style="{StaticResource SettingsInputStyle}"/>
                            </Grid>

                            <!-- Roku Username Input -->
                            <Grid Grid.Row="2" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="Username:"
                                         Foreground="White"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"
                                         Width="130"/>
                                
                                <TextBox Grid.Column="1"
                                         Text="{Binding RokuUsername}"
                                         Style="{StaticResource SettingsInputStyle}"/>
                            </Grid>

                            <!-- Roku Password Input -->
                            <Grid Grid.Row="3" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="Password:"
                                         Foreground="White"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"
                                         Width="130"/>
                                
                                <TextBox Grid.Column="1"
                                         Text="{Binding RokuPassword}"
                                         Style="{StaticResource SettingsInputStyle}"/>
                            </Grid>

                            <!-- Setup Instructions -->
                            <Expander Grid.Row="4"
                                     Header="How to Enable Developer Mode"
                                     Style="{StaticResource SettingsExpanderStyle}">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="To enable Developer Mode on your Roku device:"
                                             Foreground="White"
                                             Margin="0,0,0,8"/>
                                    <TextBlock Text="1. Press Home 5 times, Up 1 time, Rewind 2 times, Fast Forward 2 times"
                                             Foreground="{DynamicResource TextMutedBrush}"
                                             Margin="0,0,0,4"/>
                                    <TextBlock Text="2. Wait for the Developer Mode screen to appear"
                                             Foreground="{DynamicResource TextMutedBrush}"
                                             Margin="0,0,0,4"/>
                                    <TextBlock Text="3. Note down the IP address, username, and password"
                                             Foreground="{DynamicResource TextMutedBrush}"
                                             Margin="0,0,0,4"/>
                                    <TextBlock Text="4. Enter the credentials above (default username is 'rokudev')"
                                             Foreground="{DynamicResource TextMutedBrush}"
                                             Margin="0,0,0,4"/>
                                </StackPanel>
                            </Expander>
                        </Grid>
                    </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
<UserControl x:Class="TinyCinema.RandomPickOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             Visibility="Collapsed"
             IsHitTestVisible="True">
    <Grid x:Name="RootGrid"
          Background="#D9000000"
          MouseLeftButtonDown="RootGrid_MouseLeftButtonDown">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="680"
                MinWidth="400"
                Margin="24"
                Background="#141414"
                BorderBrush="#333333"
                BorderThickness="1"
                CornerRadius="20"
                Padding="28,24"
                MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28"
                                  ShadowDepth="0"
                                  Opacity="0.55"
                                  Color="#000000"/>
            </Border.Effect>

            <StackPanel HorizontalAlignment="Stretch">
                <Grid x:Name="DiceHeader"
                      Width="96"
                      Height="96"
                      Margin="0,0,0,16"
                      HorizontalAlignment="Center">
                    <Ellipse Fill="#221A10"
                             Stroke="#8A6A1A"
                             StrokeThickness="2"/>
                    <TextBlock Text="🎲"
                               FontSize="46"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="DiceRotate" Angle="0"/>
                                <ScaleTransform x:Name="DiceScale" ScaleX="1" ScaleY="1"/>
                            </TransformGroup>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>

                <TextBlock x:Name="StatusText"
                           Text="Rolling the dice..."
                           Foreground="#7EC8FF"
                           FontSize="14"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <Border x:Name="RevealCard"
                        Background="#0F0F0F"
                        BorderBrush="#2A2A2A"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16"
                        Opacity="0.4">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="RevealScale" ScaleX="0.94" ScaleY="0.94"/>
                    </Border.RenderTransform>
                    <Border.RenderTransformOrigin>
                        <Point X="0.5" Y="0.5"/>
                    </Border.RenderTransformOrigin>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#1A1A1A"
                                CornerRadius="10"
                                ClipToBounds="True"
                                Height="210"
                                Margin="0,0,16,0">
                            <Grid>
                                <fa:FontAwesome Icon="Film"
                                                Foreground="#444"
                                                Width="42"
                                                Height="42"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                <Image x:Name="PosterImage"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="TitleText"
                                       Text=""
                                       Foreground="White"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"/>

                            <TextBlock x:Name="SubtitleText"
                                       Text=""
                                       Foreground="#AAAAAA"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                            <TextBlock x:Name="DirectorText"
                                       Text=""
                                       Foreground="#CCCCCC"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4"/>

                            <TextBlock x:Name="CastText"
                                       Text=""
                                       Foreground="#999999"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                            <ScrollViewer MaxHeight="96"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="DescriptionText"
                                           Text=""
                                           Foreground="#BBBBBB"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           LineHeight="18"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel x:Name="ActionPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0"
                            Visibility="Collapsed">
                    <Button x:Name="WatchButton"
                            Content="Watch"
                            Style="{StaticResource HeroPrimaryButtonStyle}"
                            Padding="28,10"
                            Margin="0,0,10,0"
                            Click="WatchButton_Click"/>
                    <Button x:Name="PreviewButton"
                            Content="Trailer"
                            Padding="28,10"
                            Margin="0,0,10,0"
                            Background="#242424"
                            Foreground="White"
                            BorderBrush="#555"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="PreviewButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3A3A3A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="RollAgainButton"
                            Content="Roll Again"
                            Padding="28,10"
                            Background="#2A2A2A"
                            Foreground="White"
                            BorderBrush="#444"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="RollAgainButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3A3A3A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

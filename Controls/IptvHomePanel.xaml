<UserControl x:Class="TinyCinema.IptvHomePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:FontAwesome="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
             xmlns:local="clr-namespace:TinyCinema">
    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:FavoriteIconConverter x:Key="FavoriteIconConverter"/>
        <local:FavoriteColorConverter x:Key="FavoriteColorConverter"/>

        <Style x:Key="IptvCategoryCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardRoot"
                                CornerRadius="14"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Padding="16">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="CardRoot" Property="Background" Value="#151B28"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardRoot" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IptvFeaturedCardButtonStyle" TargetType="Button" BasedOn="{StaticResource IptvCategoryCardButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FeaturedRoot"
                                CornerRadius="16"
                                BorderThickness="1"
                                BorderBrush="#55DC2626"
                                Padding="20">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#331F0505" Offset="0"/>
                                    <GradientStop Color="#55220A0A" Offset="0.55"/>
                                    <GradientStop Color="#331A1010" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FeaturedRoot" Property="BorderBrush" Value="#E0555555"/>
                                <Setter TargetName="FeaturedRoot" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#44281010" Offset="0"/>
                                            <GradientStop Color="#66381818" Offset="0.55"/>
                                            <GradientStop Color="#44201818" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IptvToolbarToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#B3FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#331A2744"/>
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IptvPlayCircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PlayCircle"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20">
                            <FontAwesome:FontAwesome Icon="Play"
                                                     Foreground="White"
                                                     Width="14"
                                                     Height="14"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Margin="2,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PlayCircle" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IptvFavoriteCircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2E2E2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Categories -->
        <Grid x:Name="CategoriesView">
            <ScrollViewer Style="{StaticResource ModernScrollViewerStyle}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,16">
                    <!-- Hero -->
                    <Border CornerRadius="16"
                            Margin="0,0,0,18"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Padding="24,22">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#221A2744" Offset="0"/>
                                <GradientStop Color="#180B0F14" Offset="0.45"/>
                                <GradientStop Color="#22152535" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Background="{DynamicResource AccentBrush}"
                                            CornerRadius="8"
                                            Padding="8"
                                            Margin="0,0,12,0">
                                        <FontAwesome:FontAwesome Icon="PlayCircle"
                                                                 Foreground="White"
                                                                 Width="18"
                                                                 Height="18"/>
                                    </Border>
                                    <TextBlock Text="Live IPTV"
                                               Foreground="White"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Browse free live channels by category. Select a playlist, pick a channel, and watch instantly in FFPLAY."
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           LineHeight="22"
                                           MaxWidth="640"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Background="#22000000"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16,12"
                                    Margin="16,0,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Powered by"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="iptv-org"
                                               Foreground="White"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Featured favorites -->
                    <Button x:Name="FeaturedFavoritesButton"
                            Style="{StaticResource IptvFeaturedCardButtonStyle}"
                            Click="FeaturedFavoritesButton_Click"
                            Margin="0,0,0,22"
                            HorizontalAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="56"
                                    Height="56"
                                    CornerRadius="14"
                                    Background="#33DC2626"
                                    Margin="0,0,16,0">
                                <FontAwesome:FontAwesome Icon="Heart"
                                                         Foreground="#F87171"
                                                         Width="24"
                                                         Height="24"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Favorite Channels"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="FeaturedFavoritesCountText"
                                           Text="Your saved channels"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="13"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Text="Open"
                                           Foreground="#F87171"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <FontAwesome:FontAwesome Icon="ChevronRight"
                                                         Foreground="#F87171"
                                                         Width="12"
                                                         Height="12"
                                                         Margin="8,0,0,0"
                                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <TextBlock Text="Browse Categories"
                               Foreground="White"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14"/>

                    <ItemsControl x:Name="CategoriesItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:IptvCategory}">
                                <Button Click="CategoryButton_Click"
                                        Tag="{Binding}"
                                        Style="{StaticResource IptvCategoryCardButtonStyle}"
                                        Width="210"
                                        Height="112"
                                        Margin="0,0,14,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Width="38"
                                                Height="38"
                                                CornerRadius="10"
                                                BorderThickness="1"
                                                BorderBrush="#33FFFFFF"
                                                Margin="0,0,0,0">
                                            <Grid>
                                                <Border Background="{Binding AccentBrush}"
                                                        Opacity="0.18"
                                                        CornerRadius="10"/>
                                                <FontAwesome:FontAwesome Icon="{Binding CategoryIcon}"
                                                                         Foreground="{Binding AccentBrush}"
                                                                         Width="16"
                                                                         Height="16"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Margin="0,12,0,0"
                                                   VerticalAlignment="Top"/>

                                        <Border Grid.Row="2"
                                                Background="#22000000"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="999"
                                                Padding="10,4"
                                                HorizontalAlignment="Left"
                                                Margin="0,10,0,0">
                                            <TextBlock Text="{Binding ListedChannelCount, StringFormat={}{0:N0} channels}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="11"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Channels -->
        <Grid x:Name="ChannelsView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    CornerRadius="14"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Padding="16"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Click="BackButton_Click"
                                Style="{StaticResource HeroSecondaryButtonStyle}"
                                Padding="12,8"
                                Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <FontAwesome:FontAwesome Icon="ChevronLeft" Width="12" Height="12" Margin="0,0,8,0"/>
                                <TextBlock Text="Categories"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ChannelsTitleText"
                                       Text="Channels"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="ChannelsSubtitleText"
                                       Text="Loading..."
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="13"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <ToggleButton x:Name="FavoritesOnlyToggle"
                                          Style="{StaticResource IptvToolbarToggleStyle}"
                                          Click="FavoritesOnlyToggle_Click"
                                          Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <FontAwesome:FontAwesome Icon="HeartOutline" Width="12" Height="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Favorites"/>
                                </StackPanel>
                            </ToggleButton>
                            <Button Click="RefreshButton_Click"
                                    Style="{StaticResource HeroSecondaryButtonStyle}"
                                    Padding="12,8">
                                <StackPanel Orientation="Horizontal">
                                    <FontAwesome:FontAwesome Icon="Refresh" Width="12" Height="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Refresh"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#18000000"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,14,0,0">
                        <TextBlock x:Name="ChannelsHintText"
                                   Text="Double-click a channel or press the play button to start FFPLAY."
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12"/>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ListView x:Name="ChannelsListView"
                          Background="Transparent"
                          BorderThickness="0"
                          SelectionMode="Single"
                          MouseDoubleClick="ChannelsListView_MouseDoubleClick"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="RowBorder"
                                                Background="{DynamicResource PanelBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="14,12"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="RowBorder" Property="Background" Value="#151B28"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:IptvChannel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="52"
                                        Height="52"
                                        CornerRadius="12"
                                        Background="#141414"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                    <Grid>
                                        <FontAwesome:FontAwesome Icon="Television"
                                                                 Foreground="#475569"
                                                                 Width="20"
                                                                 Height="20"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>
                                        <Image Source="{Binding LogoImage}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="White"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding GroupTitle}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Background="#33F59E0B"
                                                BorderBrush="#55F59E0B"
                                                BorderThickness="1"
                                                CornerRadius="999"
                                                Padding="8,3"
                                                Margin="0,0,6,0"
                                                Visibility="{Binding IsGeoBlocked, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                            <TextBlock Text="Geo-blocked"
                                                       Foreground="#FBBF24"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="#33475569"
                                                BorderBrush="#5564748B"
                                                BorderThickness="1"
                                                CornerRadius="999"
                                                Padding="8,3"
                                                Visibility="{Binding IsNot247, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                            <TextBlock Text="Not 24/7"
                                                       Foreground="#94A3B8"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Click="FavoriteChannelButton_Click"
                                        Tag="{Binding}"
                                        Style="{StaticResource IptvFavoriteCircleButtonStyle}"
                                        Margin="0,0,10,0">
                                    <FontAwesome:FontAwesome Icon="{Binding IsFavorite, Converter={StaticResource FavoriteIconConverter}}"
                                                             Foreground="{Binding IsFavorite, Converter={StaticResource FavoriteColorConverter}}"
                                                             Width="14"
                                                             Height="14"/>
                                </Button>

                                <Button Grid.Column="3"
                                        Click="PlayChannelButton_Click"
                                        Tag="{Binding}"
                                        Style="{StaticResource IptvPlayCircleButtonStyle}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border x:Name="ChannelsLoadingPanel"
                        Background="#CC0B0F14"
                        CornerRadius="14"
                        Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <FontAwesome:FontAwesome Icon="Spinner"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 Width="32"
                                                 Height="32"
                                                 HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ChannelsLoadingText"
                                   Text="Loading channels..."
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,16,0,4"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Fetching playlist from iptv-org"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="13"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="ChannelsEmptyPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="28,24"
                            MinWidth="320">
                        <StackPanel HorizontalAlignment="Center">
                            <FontAwesome:FontAwesome Icon="Television"
                                                     Foreground="#475569"
                                                     Width="36"
                                                     Height="36"
                                                     HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ChannelsEmptyText"
                                       Text="No channels match your search."
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,6"
                                       TextAlignment="Center"/>
                            <TextBlock Text="Try another search or refresh the playlist."
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

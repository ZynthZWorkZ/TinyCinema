<UserControl x:Class="TinyCinema.WatchedHomePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:FontAwesome="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
             xmlns:local="clr-namespace:TinyCinema">
    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:WatchedIconConverter x:Key="WatchedIconConverter"/>
        <local:WatchedColorConverter x:Key="WatchedColorConverter"/>
        <local:WatchedCardBorderConverter x:Key="WatchedCardBorderConverter"/>

        <Style x:Key="WatchedFilterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#B3FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FilterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FilterBorder" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WatchedCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WatchedEyeCircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#CC0B0F14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="EyeCircle"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">
                            <FontAwesome:FontAwesome Icon="Eye"
                                                     Foreground="#10B981"
                                                     Width="14"
                                                     Height="14"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EyeCircle" Property="Background" Value="#EE111827"/>
                                <Setter TargetName="EyeCircle" Property="BorderBrush" Value="#10B981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="MainScrollViewer"
                      Style="{StaticResource ModernScrollViewerStyle}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="MainScrollViewer_PreviewMouseWheel">
            <StackPanel Margin="0,0,4,12">
                <Border CornerRadius="16"
                        BorderThickness="1"
                        BorderBrush="#334155"
                        Padding="24,22"
                        Margin="0,0,0,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1A102820" Offset="0"/>
                            <GradientStop Color="#22101828" Offset="0.45"/>
                            <GradientStop Color="#18122030" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="#2210B981"
                                        CornerRadius="10"
                                        Padding="10"
                                        Margin="0,0,14,0">
                                    <FontAwesome:FontAwesome Icon="Eye"
                                                             Foreground="#10B981"
                                                             Width="22"
                                                             Height="22"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Watched"
                                               Foreground="White"
                                               FontSize="24"
                                               FontWeight="Bold"/>
                                    <TextBlock x:Name="WatchedCountText"
                                               Text="0 titles watched"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="13"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Keep track of every movie and TV show you've seen. Mark titles with the eye icon as you finish them."
                                       Foreground="#94A3B8"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       MaxWidth="560"
                                       LineHeight="20"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Background="#151B28"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16,12"
                                    Margin="0,0,10,0"
                                    MinWidth="88">
                                <StackPanel HorizontalAlignment="Center">
                                    <FontAwesome:FontAwesome Icon="Film"
                                                             Foreground="{DynamicResource AccentBrush}"
                                                             Width="16"
                                                             Height="16"
                                                             HorizontalAlignment="Center"
                                                             Margin="0,0,0,6"/>
                                    <TextBlock x:Name="MoviesStatText"
                                               Text="0"
                                               Foreground="White"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Movies"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#151B28"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16,12"
                                    MinWidth="88">
                                <StackPanel HorizontalAlignment="Center">
                                    <FontAwesome:FontAwesome Icon="Television"
                                                             Foreground="{DynamicResource AccentBrush}"
                                                             Width="16"
                                                             Height="16"
                                                             HorizontalAlignment="Center"
                                                             Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TvShowsStatText"
                                               Text="0"
                                               Foreground="White"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="TV Shows"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button x:Name="AllFilterButton"
                            Tag="All"
                            Style="{StaticResource WatchedFilterButtonStyle}"
                            Click="FilterButton_Click"
                            Margin="0,0,8,0">
                        <TextBlock Text="All" FontWeight="SemiBold"/>
                    </Button>
                    <Button x:Name="MoviesFilterButton"
                            Tag="Movies"
                            Style="{StaticResource WatchedFilterButtonStyle}"
                            Click="FilterButton_Click"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <FontAwesome:FontAwesome Icon="Film" Width="12" Height="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Movies" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TvShowsFilterButton"
                            Tag="TvShows"
                            Style="{StaticResource WatchedFilterButtonStyle}"
                            Click="FilterButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <FontAwesome:FontAwesome Icon="Television" Width="12" Height="12" Margin="0,0,8,0"/>
                            <TextBlock Text="TV Shows" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ItemsControl x:Name="WatchedItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:WatchedCardViewModel}">
                            <Button Style="{StaticResource WatchedCardButtonStyle}"
                                    Tag="{Binding}"
                                    Click="CardButton_Click"
                                    Margin="0,0,14,14">
                                <Border Width="168"
                                        Height="278"
                                        CornerRadius="12"
                                        BorderThickness="2"
                                        BorderBrush="{Binding IsSelected, Converter={StaticResource WatchedCardBorderConverter}}"
                                        Background="{DynamicResource PanelBackgroundBrush}"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Border Background="#111827">
                                            <Image Source="{Binding Movie.CachedImage}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>

                                        <Border VerticalAlignment="Top"
                                                HorizontalAlignment="Right"
                                                Margin="8"
                                                ToolTip="Mark as unwatched">
                                            <Button Style="{StaticResource WatchedEyeCircleButtonStyle}"
                                                    Tag="{Binding}"
                                                    Click="UnwatchButton_Click"/>
                                        </Border>

                                        <Border VerticalAlignment="Top"
                                                HorizontalAlignment="Left"
                                                Margin="8,8,0,0"
                                                Background="#CC0B0F14"
                                                BorderBrush="#334155"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,4">
                                            <TextBlock Text="{Binding Movie.ContentTypeLabel}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"/>
                                        </Border>

                                        <Border VerticalAlignment="Bottom">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0"/>
                                                    <GradientStop Color="#DD0B0F14" Offset="0.35"/>
                                                    <GradientStop Color="#F00B0F14" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel Margin="12,28,12,12">
                                                <TextBlock Text="{Binding Movie.Title}"
                                                           Foreground="White"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="40"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding Movie.Year}"
                                                               Foreground="#94A3B8"
                                                               FontSize="12"
                                                               Margin="0,0,10,0"/>
                                                    <FontAwesome:FontAwesome Icon="Eye"
                                                                             Foreground="#10B981"
                                                                             Width="10"
                                                                             Height="10"
                                                                             Margin="0,0,6,0"
                                                                             VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding WatchedDateLabel}"
                                                               Foreground="#64748B"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="EmptyStatePanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
            <Border Background="#151B28"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="40"
                    Width="80"
                    Height="80"
                    Margin="0,0,0,18">
                <FontAwesome:FontAwesome Icon="EyeSlash"
                                         Foreground="#475569"
                                         Width="34"
                                         Height="34"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Nothing watched yet"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>
            <TextBlock Text="Browse Movies or TV Shows and tap the eye icon when you've finished a title. Your watch history will appear here."
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="420"
                       LineHeight="22"/>
        </StackPanel>
    </Grid>
</UserControl>

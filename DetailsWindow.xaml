<Window x:Class="TinyCinema.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TinyCinema"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        mc:Ignorable="d"
        Title="Movie Details" 
        Height="700" 
        Width="950"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True">
    <Window.Resources>
        <!-- Window Button Style -->
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Close Button Style -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ScrollBar Style -->
        <Style x:Key="ModernScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" 
                               IsDirectionReversed="True"
                               Focusable="False">
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" 
                                       Background="#2A2A2A"
                                       BorderThickness="0">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="4"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ScrollViewer Style -->
        <Style x:Key="ModernScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                     Grid.Column="1"
                                     Style="{StaticResource ModernScrollBarStyle}"
                                     Orientation="Vertical"
                                     Value="{TemplateBinding VerticalOffset}"
                                     Maximum="{TemplateBinding ScrollableHeight}"
                                     ViewportSize="{TemplateBinding ViewportHeight}"
                                     Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#0F0F0F" 
            CornerRadius="16"
            BorderThickness="1"
            BorderBrush="#2A2A2A">
        <Grid>
            <!-- Background Image with Dimming -->
            <Grid x:Name="BackgroundGrid">
                <Image x:Name="BackgroundImage" 
                       Stretch="UniformToFill" 
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <Rectangle Fill="#CC000000" Opacity="0.85"/>
            </Grid>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Grid Grid.Row="0" 
                      Background="#1A1A1A"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Title -->
                    <TextBlock x:Name="TitleText"
                              Foreground="White"
                              FontSize="14"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"/>
                    
                    <!-- Close Button -->
                    <Button Grid.Column="1"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_Click">
                        <fa:FontAwesome Icon="Close" 
                                       Foreground="White"
                                       Width="12" 
                                       Height="12"/>
                    </Button>
                </Grid>

                <!-- Content -->
                <ScrollViewer Grid.Row="1" 
                             Style="{StaticResource ModernScrollViewerStyle}"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="32,24,32,32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Side - Poster -->
                        <Border Grid.Column="0"
                               CornerRadius="12"
                               Margin="0,0,24,0"
                               Background="#1A1A1A"
                               BorderThickness="1"
                               BorderBrush="#2A2A2A">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" 
                                                ShadowDepth="4" 
                                                Opacity="0.4" 
                                                Color="Black"/>
                            </Border.Effect>
                            <Border CornerRadius="12" ClipToBounds="True">
                                <Grid>
                                    <!-- Poster Image -->
                                    <Image x:Name="PosterImage" 
                                          Stretch="UniformToFill"
                                          RenderOptions.BitmapScalingMode="HighQuality"/>
                                    
                                    <!-- Subtle gradient overlay -->
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="Transparent" Offset="0"/>
                                                <GradientStop Color="#10000000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    
                                    <!-- Fallback if no image -->
                                    <Grid x:Name="PosterPlaceholder" Visibility="Collapsed">
                                        <fa:FontAwesome Icon="Film" 
                                                       Foreground="#3A3A3A"
                                                       Width="80" 
                                                       Height="80"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Border>

                        <!-- Right Side - Details -->
                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <!-- Title Section -->
                            <Border Background="#1A1A1A"
                                   CornerRadius="12"
                                   Padding="24,20"
                                   Margin="0,0,0,16"
                                   BorderThickness="1"
                                   BorderBrush="#2A2A2A">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" 
                                                    ShadowDepth="2" 
                                                    Opacity="0.2" 
                                                    Color="Black"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock x:Name="MovieTitleText"
                                             FontSize="28"
                                             FontWeight="Bold"
                                             Foreground="White"
                                             TextWrapping="Wrap"
                                             Margin="0,0,0,12"/>
                                    
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#2A2A2A"
                                               CornerRadius="4"
                                               Padding="8,4"
                                               Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <fa:FontAwesome Icon="Calendar" 
                                                              Foreground="#B3B3B3"
                                                              Width="12" 
                                                              Height="12"
                                                              Margin="0,0,6,0"
                                                              VerticalAlignment="Center"/>
                                                <TextBlock x:Name="YearText"
                                                         FontSize="13"
                                                         Foreground="#B3B3B3"
                                                         VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Genre Section -->
                            <Border x:Name="GenreSection"
                                   Background="#1A1A1A"
                                   CornerRadius="12"
                                   Padding="24,20"
                                   Margin="0,0,0,16"
                                   BorderThickness="1"
                                   BorderBrush="#2A2A2A">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" 
                                                    ShadowDepth="2" 
                                                    Opacity="0.2" 
                                                    Color="Black"/>
                                </Border.Effect>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <fa:FontAwesome Icon="Tags" 
                                                       Foreground="White"
                                                       Width="16" 
                                                       Height="16"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"/>
                                        <TextBlock Text="Genres &amp; Info"
                                                 FontSize="16"
                                                 FontWeight="SemiBold"
                                                 Foreground="White"
                                                 VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <TextBlock x:Name="GenreText"
                                             FontSize="14"
                                             Foreground="#CCCCCC"
                                             TextWrapping="Wrap"
                                             LineHeight="24"
                                             TextTrimming="None"/>
                                </StackPanel>
                            </Border>

                            <!-- Cast Section -->
                            <Border x:Name="CastSection"
                                   Background="#1A1A1A"
                                   CornerRadius="12"
                                   Padding="24,20"
                                   Margin="0,0,0,16"
                                   BorderThickness="1"
                                   BorderBrush="#2A2A2A"
                                   Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" 
                                                    ShadowDepth="2" 
                                                    Opacity="0.2" 
                                                    Color="Black"/>
                                </Border.Effect>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <fa:FontAwesome Icon="Users" 
                                                       Foreground="White"
                                                       Width="16" 
                                                       Height="16"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"/>
                                        <TextBlock Text="Cast"
                                                 FontSize="16"
                                                 FontWeight="SemiBold"
                                                 Foreground="White"
                                                 VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                 VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="CastImagesPanel"
                                                   Orientation="Horizontal"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <!-- Description Section -->
                            <Border x:Name="DescriptionSection"
                                   Background="#1A1A1A"
                                   CornerRadius="12"
                                   Padding="24,20"
                                   BorderThickness="1"
                                   BorderBrush="#2A2A2A">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" 
                                                    ShadowDepth="2" 
                                                    Opacity="0.2" 
                                                    Color="Black"/>
                                </Border.Effect>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <fa:FontAwesome Icon="AlignLeft" 
                                                       Foreground="White"
                                                       Width="16" 
                                                       Height="16"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"/>
                                        <TextBlock Text="Description"
                                                 FontSize="16"
                                                 FontWeight="SemiBold"
                                                 Foreground="White"
                                                 VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <TextBlock x:Name="DescriptionText"
                                             FontSize="14"
                                             Foreground="#CCCCCC"
                                             TextWrapping="Wrap"
                                             LineHeight="24"
                                             TextAlignment="Justify"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window> 
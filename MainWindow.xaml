<Window x:Class="TinyCinema.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TinyCinema"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:FontAwesome="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
        mc:Ignorable="d"
        Title="TinyCinema"
        Height="800"
        Width="1280"
        MinHeight="640"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:FavoriteIconConverter x:Key="FavoriteIconConverter"/>
        <local:FavoriteColorConverter x:Key="FavoriteColorConverter"/>
    </Window.Resources>

    <Border Background="{DynamicResource AppBackgroundBrush}"
            CornerRadius="16"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    CornerRadius="16,0,0,16"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand -->
                    <StackPanel Grid.Row="0" Margin="20,24,16,24">
                        <TextBlock Text="TinyCinema"
                                   FontFamily="{StaticResource AbsoluteXeroFont}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{Binding CatalogCountText}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Navigation -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button x:Name="NavMoviesButton"
                                Tag="Movies"
                                Style="{StaticResource SidebarNavButtonStyle}"
                                Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <FontAwesome:FontAwesome Icon="Film" Width="16" Height="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Movies" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavTvShowsButton"
                                Tag="TvShows"
                                Style="{StaticResource SidebarNavButtonStyle}"
                                Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <FontAwesome:FontAwesome Icon="Television" Width="16" Height="16" Margin="0,0,12,0"/>
                                <TextBlock Text="TV Shows" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavExploreButton"
                                Tag="Explore"
                                Style="{StaticResource SidebarNavButtonStyle}"
                                Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <FontAwesome:FontAwesome Icon="Compass" Width="16" Height="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Explore" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavFavoritesButton"
                                Tag="Favorites"
                                Style="{StaticResource SidebarNavButtonStyle}"
                                Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <FontAwesome:FontAwesome Icon="Heart" Width="16" Height="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Favorites" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Settings at bottom -->
                    <Button Grid.Row="2"
                            x:Name="NavSettingsButton"
                            Style="{StaticResource SidebarNavButtonStyle}"
                            Click="SettingsButton_Click"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <FontAwesome:FontAwesome Icon="Cog" Width="16" Height="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Main content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid Grid.Row="0"
                      Background="{DynamicResource TitleBarBackgroundBrush}"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="ShuffleButton"
                                Click="ShuffleButton_Click"
                                Style="{StaticResource ActionButtonStyle}"
                                ToolTip="Shuffle">
                            <FontAwesome:FontAwesome Icon="Random" Foreground="White" Width="14" Height="14"/>
                        </Button>
                        <Button x:Name="SortButton"
                                Click="SortButton_Click"
                                Style="{StaticResource ActionButtonStyle}"
                                ToolTip="Sort">
                            <FontAwesome:FontAwesome Icon="Sort" Foreground="White" Width="14" Height="14"/>
                        </Button>
                        <Button Style="{StaticResource WindowButtonStyle}" Click="MinimizeButton_Click">
                            <fa:FontAwesome Icon="WindowMinimize" Foreground="White" Width="12" Height="12"/>
                        </Button>
                        <Button Style="{StaticResource WindowButtonStyle}" Click="MaximizeButton_Click">
                            <fa:FontAwesome Icon="WindowMaximize" Foreground="White" Width="12" Height="12"/>
                        </Button>
                        <Button Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click">
                            <fa:FontAwesome Icon="Close" Foreground="White" Width="12" Height="12"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Search & filters -->
                <Border Grid.Row="1" Padding="24,16,24,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource SearchBoxStyle}"
                                     TextChanged="SearchBox_TextChanged"/>
                            <TextBlock x:Name="SearchPlaceholder"
                                       Text="Search for movies or TV shows..."
                                       Foreground="{DynamicResource InputMutedForegroundBrush}"
                                       Margin="40,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                        <ComboBox x:Name="GenreFilter"
                                  Grid.Column="1"
                                  Margin="12,0,0,0"
                                  Width="150"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  SelectionChanged="GenreFilter_SelectionChanged"/>
                        <ComboBox x:Name="CountryFilter"
                                  Grid.Column="2"
                                  Margin="12,0,0,0"
                                  Width="150"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  SelectionChanged="CountryFilter_SelectionChanged"/>
                    </Grid>
                </Border>

                <!-- Hero panel -->
                <local:CatalogHeroPanel x:Name="HeroPanel"
                                        Grid.Row="2"
                                        Margin="24,0,24,0"/>

                <!-- Poster grid -->
                <Grid Grid.Row="3" Margin="24,16,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="GridSectionTitle"
                               Grid.Row="0"
                               Text="Explore"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="EmptyGridText"
                               Grid.Row="1"
                               Text="No titles match your filters."
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>

                    <ScrollViewer x:Name="PosterScrollViewer"
                                  Grid.Row="1"
                                  Style="{StaticResource ModernScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                        <ListView x:Name="MoviesListView"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  SelectionMode="Single"
                                  KeyDown="MoviesListView_KeyDown"
                                  SelectionChanged="MoviesListView_SelectionChanged">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,14,14"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="CardBorder"
                                                        Width="150"
                                                        Height="225"
                                                        CornerRadius="10"
                                                        BorderThickness="2"
                                                        BorderBrush="Transparent"
                                                        Background="{DynamicResource PanelBackgroundBrush}"
                                                        ClipToBounds="True"
                                                        Cursor="Hand">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="#334155"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="150" Height="225">
                                        <!-- Loading -->
                                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                            <fa:FontAwesome Icon="Spinner"
                                                            Foreground="{DynamicResource InputMutedForegroundBrush}"
                                                            Width="28"
                                                            Height="28"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Poster -->
                                        <Image Source="{Binding CachedImage}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>

                                        <!-- Title overlay -->
                                        <Border VerticalAlignment="Bottom">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0"/>
                                                    <GradientStop Color="#DD0B0F14" Offset="0.35"/>
                                                    <GradientStop Color="#F00B0F14" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="White"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="40"
                                                       Margin="10,24,10,10"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>

                    <local:ExploreHomePanel x:Name="ExploreHomePanel"
                                            Grid.Row="1"
                                            VerticalAlignment="Stretch"
                                            HorizontalAlignment="Stretch"
                                            Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

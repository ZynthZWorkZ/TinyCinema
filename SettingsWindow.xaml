<Window x:Class="TinyCinema.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TinyCinema"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Settings" Height="720" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Opacity="1">
    
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Modern Toggle Style -->
        <Style x:Key="ModernToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Background"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="12"
                                    BorderThickness="1"
                                    BorderBrush="#3A3A3A"/>
                            <Border x:Name="Thumb"
                                    Width="20"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    Margin="2,0,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" 
                                                    ShadowDepth="1" 
                                                    Opacity="0.2" 
                                                    Color="Black"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="#007ACC"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Background" Property="BorderBrush" Value="#4A4A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="#3A3A3A">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Modern ComboBox Style -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="PART_Button"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <DockPanel>
                                    <ContentPresenter x:Name="ContentSite"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Margin="4,0,0,0"
                                                      RecognizesAccessKey="True"/>
                                    <Path x:Name="Arrow"
                                          Width="12" Height="8"
                                          Margin="8,0,8,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          Fill="#FFFFFF"
                                          Data="M 0 0 L 6 8 L 12 0 Z"/>
                                </DockPanel>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#1A1A1A"
                                        BorderBrush="#2A2A2A"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ScrollViewer MaxHeight="300">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Button" Property="Background" Value="#232323"/>
                                <Setter TargetName="PART_Button" Property="BorderBrush" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="PART_Button" Property="Background" Value="#232323"/>
                                <Setter TargetName="PART_Button" Property="BorderBrush" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#555"/>
                                <Setter TargetName="PART_Button" Property="Background" Value="#181818"/>
                                <Setter TargetName="PART_Button" Property="BorderBrush" Value="#222"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Close Button Style -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0F0F0F" 
            CornerRadius="20"
            BorderThickness="1"
            BorderBrush="#2A2A2A">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Settings Title Bar -->
            <Grid Grid.Row="0" 
                  Background="#1A1A1A"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Settings Title -->
                <StackPanel Orientation="Horizontal" 
                          Margin="12,0,0,0"
                          VerticalAlignment="Center">
                    <fa:FontAwesome Icon="Cog" 
                                   Foreground="White"
                                   Width="14" 
                                   Height="14"
                                   Margin="0,0,8,0"/>
                    <TextBlock Text="Settings" 
                             Foreground="White"
                             FontSize="14"
                             VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Close Settings Button -->
                <Button Grid.Column="1"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="CloseButton_Click">
                    <fa:FontAwesome Icon="Close" 
                                   Foreground="White"
                                   Width="12" 
                                   Height="12"/>
                </Button>
            </Grid>

            <!-- Settings Content -->
            <ScrollViewer Grid.Row="1" 
                         VerticalScrollBarVisibility="Auto"
                         Padding="24">
                <StackPanel>
                    <TextBlock Text="Settings"
                             FontSize="24"
                             FontWeight="Bold"
                             Foreground="White"
                             Margin="0,0,0,24"/>
                    
                    <!-- Cache Location Setting -->
                    <Border Background="#1A1A1A"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Setting Title -->
                            <StackPanel Orientation="Horizontal" 
                                      Margin="0,0,0,12">
                                <fa:FontAwesome Icon="Folder" 
                                               Foreground="White"
                                               Width="16" 
                                               Height="16"
                                               Margin="0,0,8,0"/>
                                <TextBlock Text="Image Cache Settings" 
                                         Foreground="White"
                                         FontSize="16"
                                         FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <!-- Enable Caching Toggle -->
                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="Enable Image Caching"
                                         Foreground="White"
                                         VerticalAlignment="Center"/>
                                
                                <ToggleButton Grid.Column="1"
                                             IsChecked="{Binding IsCachingEnabled}"
                                             Style="{StaticResource ModernToggleStyle}"/>
                            </Grid>
                            
                            <!-- Cache Path and Button -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="{Binding CacheLocation}"
                                         Foreground="#B3FFFFFF"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Center"
                                         Margin="0,0,16,0"/>
                                
                                <Button Grid.Column="1"
                                        Content="Change Location"
                                        Click="SelectCacheLocation_Click"
                                        Style="{StaticResource ModernButtonStyle}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- TV Show Episode Cache Setting -->
                    <Border Background="#1A1A1A"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal"
                                      Margin="0,0,0,12">
                                <fa:FontAwesome Icon="Television"
                                               Foreground="White"
                                               Width="16"
                                               Height="16"
                                               Margin="0,0,8,0"/>
                                <TextBlock Text="TV Show Cache Settings"
                                         Foreground="White"
                                         FontSize="16"
                                         FontWeight="SemiBold"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Enable TV Show Episode Caching"
                                         Foreground="White"
                                         VerticalAlignment="Center"
                                         TextWrapping="Wrap"/>

                                <ToggleButton Grid.Column="1"
                                             IsChecked="{Binding IsTvShowCachingEnabled}"
                                             Style="{StaticResource ModernToggleStyle}"/>
                            </Grid>

                            <TextBlock Grid.Row="2"
                                     Text="{Binding TvShowEpisodeCacheLocation}"
                                     Foreground="#B3FFFFFF"
                                     TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Movie Links File Location Setting -->
                    <Border Background="#1A1A1A"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Setting Title -->
                            <StackPanel Orientation="Horizontal" 
                                      Margin="0,0,0,12">
                                <fa:FontAwesome Icon="File" 
                                               Foreground="White"
                                               Width="16" 
                                               Height="16"
                                               Margin="0,0,8,0"/>
                                <TextBlock Text="Movie Links File Settings" 
                                         Foreground="White"
                                         FontSize="16"
                                         FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <!-- Movie Links File Path and Button -->
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="{Binding MovieLinksLocation}"
                                         Foreground="#B3FFFFFF"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Center"
                                         Margin="0,0,16,12"/>
                                
                                <Button Grid.Column="1"
                                        Content="Change Location"
                                        Click="SelectMovieLinksLocation_Click"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Margin="0,0,0,12"/>

                                <Button Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Content="Fetch Movies from TinyZone"
                                        Click="FetchMovies_Click"
                                        Style="{StaticResource ModernButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,8"/>

                                <Button Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        Content="Add Movie by URL"
                                        Click="AddMovieByUrl_Click"
                                        Style="{StaticResource ModernButtonStyle}"
                                        HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- TV Show Links File Location Setting -->
                    <Border Background="#1A1A1A"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal"
                                      Margin="0,0,0,12">
                                <fa:FontAwesome Icon="Television"
                                               Foreground="White"
                                               Width="16"
                                               Height="16"
                                               Margin="0,0,8,0"/>
                                <TextBlock Text="TV Show Links File Settings"
                                         Foreground="White"
                                         FontSize="16"
                                         FontWeight="SemiBold"/>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding TvShowLinksLocation}"
                                         Foreground="#B3FFFFFF"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Center"
                                         Margin="0,0,16,12"/>

                                <Button Grid.Column="1"
                                        Content="Change Location"
                                        Click="SelectTvShowLinksLocation_Click"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Margin="0,0,0,12"/>

                                <Button Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Content="Fetch TV Shows from MovieLair"
                                        Click="FetchTvShows_Click"
                                        Style="{StaticResource ModernButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,8"/>

                                <Button Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        Content="Add TV Show by URL"
                                        Click="AddTvShowByUrl_Click"
                                        Style="{StaticResource ModernButtonStyle}"
                                        HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Player Settings -->
                    <Border Background="#1A1A1A"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Setting Title -->
                            <StackPanel Grid.Row="0"
                                      Orientation="Horizontal" 
                                      Margin="0,0,0,12">
                                <fa:FontAwesome Icon="Play" 
                                               Foreground="White"
                                               Width="16" 
                                               Height="16"
                                               Margin="0,0,8,0"/>
                                <TextBlock Text="Player Settings" 
                                         Foreground="White"
                                         FontSize="16"
                                         FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <!-- Player Selection -->
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="Default Player:"
                                         Foreground="White"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"/>
                                
                                <ComboBox x:Name="PlayerComboBox"
                                         Grid.Column="1"
                                         ItemsSource="{Binding AvailablePlayers}"
                                         SelectedItem="{Binding SelectedPlayer}"
                                         SelectionChanged="PlayerComboBox_SelectionChanged"
                                         Background="#2A2A2A"
                                         Foreground="White"
                                         BorderBrush="#3A3A3A"
                                         BorderThickness="1"
                                         Padding="8,4"
                                         Style="{StaticResource ModernComboBoxStyle}"/>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Block Popups and Ads"
                                         Foreground="White"
                                         VerticalAlignment="Center"/>

                                <ToggleButton Grid.Column="1"
                                             IsChecked="{Binding IsPopupBlockerEnabled}"
                                             Style="{StaticResource ModernToggleStyle}"/>
                            </Grid>

                            <TextBlock Grid.Row="3"
                                       Text="In-App Browser watches on TinyZone. Other players open automatically when an m3u8 stream is captured."
                                       Foreground="#808080"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- TMDB Settings -->
                    <Border Background="#1A1A1A"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal"
                                      Margin="0,0,0,12">
                                <fa:FontAwesome Icon="Film"
                                               Foreground="White"
                                               Width="16"
                                               Height="16"
                                               Margin="0,0,8,0"/>
                                <TextBlock Text="TMDB Trailer Settings"
                                         Foreground="White"
                                         FontSize="16"
                                         FontWeight="SemiBold"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="API Key:"
                                         Foreground="White"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"
                                         Width="130"/>

                                <TextBox Grid.Column="1"
                                         Text="{Binding TmdbApiKey, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#2A2A2A"
                                         Foreground="White"
                                         BorderThickness="1"
                                         BorderBrush="#3A3A3A"
                                         Padding="8,4"/>
                            </Grid>

                            <TextBlock Grid.Row="2"
                                       Text="Used for trailer playback only. Get a free API key at themoviedb.org/settings/api."
                                       Foreground="#808080"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Roku Settings -->
                    <Border Background="#1A1A1A"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Setting Title -->
                            <StackPanel Orientation="Horizontal" 
                                      Margin="0,0,0,12">
                                <fa:FontAwesome Icon="Tv" 
                                               Foreground="White"
                                               Width="16" 
                                               Height="16"
                                               Margin="0,0,8,0"/>
                                <TextBlock Text="Roku Sideload Settings" 
                                         Foreground="White"
                                         FontSize="16"
                                         FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <!-- Roku IP Input -->
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="Roku IP Address:"
                                         Foreground="White"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"
                                         Width="130"/>
                                
                                <TextBox Grid.Column="1"
                                         Text="{Binding RokuIpAddress}"
                                         Background="#2A2A2A"
                                         Foreground="White"
                                         BorderThickness="1"
                                         BorderBrush="#3A3A3A"
                                         Padding="8,4"/>
                            </Grid>

                            <!-- Roku Username Input -->
                            <Grid Grid.Row="2" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="Username:"
                                         Foreground="White"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"
                                         Width="130"/>
                                
                                <TextBox Grid.Column="1"
                                         Text="{Binding RokuUsername}"
                                         Background="#2A2A2A"
                                         Foreground="White"
                                         BorderThickness="1"
                                         BorderBrush="#3A3A3A"
                                         Padding="8,4"/>
                            </Grid>

                            <!-- Roku Password Input -->
                            <Grid Grid.Row="3" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="Password:"
                                         Foreground="White"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"
                                         Width="130"/>
                                
                                <TextBox Grid.Column="1"
                                         Text="{Binding RokuPassword}"
                                         Background="#2A2A2A"
                                         Foreground="White"
                                         BorderThickness="1"
                                         BorderBrush="#3A3A3A"
                                         Padding="8,4"/>
                            </Grid>

                            <!-- Setup Instructions -->
                            <Expander Grid.Row="4"
                                     Header="How to Enable Developer Mode"
                                     Foreground="White"
                                     BorderThickness="0"
                                     Background="Transparent">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="To enable Developer Mode on your Roku device:"
                                             Foreground="White"
                                             Margin="0,0,0,8"/>
                                    <TextBlock Text="1. Press Home 5 times, Up 1 time, Rewind 2 times, Fast Forward 2 times"
                                             Foreground="#B3FFFFFF"
                                             Margin="0,0,0,4"/>
                                    <TextBlock Text="2. Wait for the Developer Mode screen to appear"
                                             Foreground="#B3FFFFFF"
                                             Margin="0,0,0,4"/>
                                    <TextBlock Text="3. Note down the IP address, username, and password"
                                             Foreground="#B3FFFFFF"
                                             Margin="0,0,0,4"/>
                                    <TextBlock Text="4. Enter the credentials above (default username is 'rokudev')"
                                             Foreground="#B3FFFFFF"
                                             Margin="0,0,0,4"/>
                                </StackPanel>
                            </Expander>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window> 